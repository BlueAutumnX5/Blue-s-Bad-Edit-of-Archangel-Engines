    label AEVC_26(AEVCB * EV_L_26)   // Mathematical dependence. Do not tamper. //
    label AEVC_27(AEVCB * EV_L_27)   // Mathematical dependence. Do not tamper. //
    label AEVC_28(AEVCB * EV_L_28)   // Mathematical dependence. Do not tamper. //
    label AEVC_29(AEVCB * EV_L_29)   // Mathematical dependence. Do not tamper. //
    label AEVC_30(AEVCB * EV_L_30)   // Mathematical dependence. Do not tamper. //
    label AEVC_31(AEVCB * EV_L_31)   // Mathematical dependence. Do not tamper. //
    label AEVC_32(AEVCB * EV_L_32)   // Mathematical dependence. Do not tamper. //

    function intake_flow((IV_Lsat / 16.0) * units.mm)
    intake_flow
        .add_flow_sample(0.0, 0.0)
        .add_flow_sample((IV_L_1),  AIVC_1  * (1.0 + (2.772588722240 / IL_d)) * IV_N)
        .add_flow_sample((IV_L_2),  AIVC_2  * (1.0 + (2.079441541680 / IL_d)) * IV_N)
        .add_flow_sample((IV_L_3),  AIVC_3  * (1.0 + (1.673976433572 / IL_d)) * IV_N)
        .add_flow_sample((IV_L_4),  AIVC_4  * (1.0 + (1.386294361120 / IL_d)) * IV_N)
        .add_flow_sample((IV_L_5),  AIVC_5  * (1.0 + (1.163150809806 / IL_d)) * IV_N)
        .add_flow_sample((IV_L_6),  AIVC_6  * (1.0 + (0.980829253012 / IL_d)) * IV_N)
        .add_flow_sample((IV_L_7),  AIVC_7  * (1.0 + (0.826678573184 / IL_d)) * IV_N)
        .add_flow_sample((IV_L_8),  AIVC_8  * (1.0 + (0.693147180560 / IL_d)) * IV_N)
        .add_flow_sample((IV_L_9),  AIVC_9  * (1.0 + (0.575364144904 / IL_d)) * IV_N)
        .add_flow_sample((IV_L_10), AIVC_10 * (1.0 + (0.470003629246 / IL_d)) * IV_N)
        .add_flow_sample((IV_L_11), AIVC_11 * (1.0 + (0.374693449441 / IL_d)) * IV_N)
        .add_flow_sample((IV_L_12), AIVC_12 * (1.0 + (0.287682072452 / IL_d)) * IV_N)
        .add_flow_sample((IV_L_13), AIVC_13 * (1.0 + (0.207639364778 / IL_d)) * IV_N)
        .add_flow_sample((IV_L_14), AIVC_14 * (1.0 + (0.133531392625 / IL_d)) * IV_N)
        .add_flow_sample((IV_L_15), AIVC_15 * (1.0 + (0.064538521138 / IL_d)) * IV_N)
        .add_flow_sample((IV_L_16), AIVC_16 *  1.0  * IV_N)
        .add_flow_sample((IV_L_17), AIVC_17 * ((IV_Lsat / IV_L_17) + ((IV_L_17 - IV_Lsat) / (10.0 * IV_L_17 * (IV_L_17 + 1.0)))) * IV_N)
        .add_flow_sample((IV_L_18), AIVC_18 * ((IV_Lsat / IV_L_18) + ((IV_L_18 - IV_Lsat) / (10.0 * IV_L_18 * (IV_L_18 + 1.0)))) * IV_N)
        .add_flow_sample((IV_L_19), AIVC_19 * ((IV_Lsat / IV_L_19) + ((IV_L_19 - IV_Lsat) / (10.0 * IV_L_19 * (IV_L_19 + 1.0)))) * IV_N)
        .add_flow_sample((IV_L_20), AIVC_20 * ((IV_Lsat / IV_L_20) + ((IV_L_20 - IV_Lsat) / (10.0 * IV_L_20 * (IV_L_20 + 1.0)))) * IV_N)
        .add_flow_sample((IV_L_21), AIVC_21 * ((IV_Lsat / IV_L_21) + ((IV_L_21 - IV_Lsat) / (10.0 * IV_L_21 * (IV_L_21 + 1.0)))) * IV_N)
        .add_flow_sample((IV_L_22), AIVC_22 * ((IV_Lsat / IV_L_22) + ((IV_L_22 - IV_Lsat) / (10.0 * IV_L_22 * (IV_L_22 + 1.0)))) * IV_N)
        .add_flow_sample((IV_L_23), AIVC_23 * ((IV_Lsat / IV_L_23) + ((IV_L_23 - IV_Lsat) / (10.0 * IV_L_23 * (IV_L_23 + 1.0)))) * IV_N)
        .add_flow_sample((IV_L_24), AIVC_24 * ((IV_Lsat / IV_L_24) + ((IV_L_24 - IV_Lsat) / (10.0 * IV_L_24 * (IV_L_24 + 1.0)))) * IV_N)
        .add_flow_sample((IV_L_25), AIVC_25 * ((IV_Lsat / IV_L_25) + ((IV_L_25 - IV_Lsat) / (10.0 * IV_L_25 * (IV_L_25 + 1.0)))) * IV_N)
        .add_flow_sample((IV_L_26), AIVC_26 * ((IV_Lsat / IV_L_26) + ((IV_L_26 - IV_Lsat) / (10.0 * IV_L_26 * (IV_L_26 + 1.0)))) * IV_N)
        .add_flow_sample((IV_L_27), AIVC_27 * ((IV_Lsat / IV_L_27) + ((IV_L_27 - IV_Lsat) / (10.0 * IV_L_27 * (IV_L_27 + 1.0)))) * IV_N)
        .add_flow_sample((IV_L_28), AIVC_28 * ((IV_Lsat / IV_L_28) + ((IV_L_28 - IV_Lsat) / (10.0 * IV_L_28 * (IV_L_28 + 1.0)))) * IV_N)
        .add_flow_sample((IV_L_29), AIVC_29 * ((IV_Lsat / IV_L_29) + ((IV_L_29 - IV_Lsat) / (10.0 * IV_L_29 * (IV_L_29 + 1.0)))) * IV_N)
        .add_flow_sample((IV_L_30), AIVC_30 * ((IV_Lsat / IV_L_30) + ((IV_L_30 - IV_Lsat) / (10.0 * IV_L_30 * (IV_L_30 + 1.0)))) * IV_N)
        .add_flow_sample((IV_L_31), AIVC_31 * ((IV_Lsat / IV_L_31) + ((IV_L_31 - IV_Lsat) / (10.0 * IV_L_31 * (IV_L_31 + 1.0)))) * IV_N)
        .add_flow_sample((IV_L_32), AIVC_32 * ((IV_Lsat / IV_L_32) + ((IV_L_32 - IV_Lsat) / (10.0 * IV_L_32 * (IV_L_32 + 1.0)))) * IV_N)

    function exhaust_flow((EV_Lsat / 16.0) * units.mm)
    exhaust_flow
        .add_flow_sample(0.0, 0.0)
        .add_flow_sample((EV_L_1),  AEVC_1  * (1.0 + (2.772588722240 / EL_d)) * EV_N)
        .add_flow_sample((EV_L_2),  AEVC_2  * (1.0 + (2.079441541680 / EL_d)) * EV_N)
        .add_flow_sample((EV_L_3),  AEVC_3  * (1.0 + (1.673976433572 / EL_d)) * EV_N)
        .add_flow_sample((EV_L_4),  AEVC_4  * (1.0 + (1.386294361120 / EL_d)) * EV_N)
        .add_flow_sample((EV_L_5),  AEVC_5  * (1.0 + (1.163150809806 / EL_d)) * EV_N)
        .add_flow_sample((EV_L_6),  AEVC_6  * (1.0 + (0.980829253012 / EL_d)) * EV_N)
        .add_flow_sample((EV_L_7),  AEVC_7  * (1.0 + (0.826678573184 / EL_d)) * EV_N)
        .add_flow_sample((EV_L_8),  AEVC_8  * (1.0 + (0.693147180560 / EL_d)) * EV_N)
        .add_flow_sample((EV_L_9),  AEVC_9  * (1.0 + (0.575364144904 / EL_d)) * EV_N)
        .add_flow_sample((EV_L_10), AEVC_10 * (1.0 + (0.470003629246 / EL_d)) * EV_N)
        .add_flow_sample((EV_L_11), AEVC_11 * (1.0 + (0.374693449441 / EL_d)) * EV_N)
        .add_flow_sample((EV_L_12), AEVC_12 * (1.0 + (0.287682072452 / EL_d)) * EV_N)
        .add_flow_sample((EV_L_13), AEVC_13 * (1.0 + (0.207639364778 / EL_d)) * EV_N)
        .add_flow_sample((EV_L_14), AEVC_14 * (1.0 + (0.133531392625 / EL_d)) * EV_N)
        .add_flow_sample((EV_L_15), AEVC_15 * (1.0 + (0.064538521138 / EL_d)) * EV_N)
        .add_flow_sample((EV_L_16), AEVC_16 *  1.0  * EV_N)
        .add_flow_sample((EV_L_17), AEVC_17 * ((EV_Lsat / EV_L_17) + ((EV_L_17 - EV_Lsat) / (10.0 * EV_L_17 * (EV_L_17 + 1.0)))) * EV_N)
        .add_flow_sample((EV_L_18), AEVC_18 * ((EV_Lsat / EV_L_18) + ((EV_L_18 - EV_Lsat) / (10.0 * EV_L_18 * (EV_L_18 + 1.0)))) * EV_N)
        .add_flow_sample((EV_L_19), AEVC_19 * ((EV_Lsat / EV_L_19) + ((EV_L_19 - EV_Lsat) / (10.0 * EV_L_19 * (EV_L_19 + 1.0)))) * EV_N)
        .add_flow_sample((EV_L_20), AEVC_20 * ((EV_Lsat / EV_L_20) + ((EV_L_20 - EV_Lsat) / (10.0 * EV_L_20 * (EV_L_20 + 1.0)))) * EV_N)
        .add_flow_sample((EV_L_21), AEVC_21 * ((EV_Lsat / EV_L_21) + ((EV_L_21 - EV_Lsat) / (10.0 * EV_L_21 * (EV_L_21 + 1.0)))) * EV_N)
        .add_flow_sample((EV_L_22), AEVC_22 * ((EV_Lsat / EV_L_22) + ((EV_L_22 - EV_Lsat) / (10.0 * EV_L_22 * (EV_L_22 + 1.0)))) * EV_N)
        .add_flow_sample((EV_L_23), AEVC_23 * ((EV_Lsat / EV_L_23) + ((EV_L_23 - EV_Lsat) / (10.0 * EV_L_23 * (EV_L_23 + 1.0)))) * EV_N)
        .add_flow_sample((EV_L_24), AEVC_24 * ((EV_Lsat / EV_L_24) + ((EV_L_24 - EV_Lsat) / (10.0 * EV_L_24 * (EV_L_24 + 1.0)))) * EV_N)
        .add_flow_sample((EV_L_25), AEVC_25 * ((EV_Lsat / EV_L_25) + ((EV_L_25 - EV_Lsat) / (10.0 * EV_L_25 * (EV_L_25 + 1.0)))) * EV_N)
        .add_flow_sample((EV_L_26), AEVC_26 * ((EV_Lsat / EV_L_26) + ((EV_L_26 - EV_Lsat) / (10.0 * EV_L_26 * (EV_L_26 + 1.0)))) * EV_N)
        .add_flow_sample((EV_L_27), AEVC_27 * ((EV_Lsat / EV_L_27) + ((EV_L_27 - EV_Lsat) / (10.0 * EV_L_27 * (EV_L_27 + 1.0)))) * EV_N)
        .add_flow_sample((EV_L_28), AEVC_28 * ((EV_Lsat / EV_L_28) + ((EV_L_28 - EV_Lsat) / (10.0 * EV_L_28 * (EV_L_28 + 1.0)))) * EV_N)
        .add_flow_sample((EV_L_29), AEVC_29 * ((EV_Lsat / EV_L_29) + ((EV_L_29 - EV_Lsat) / (10.0 * EV_L_29 * (EV_L_29 + 1.0)))) * EV_N)
        .add_flow_sample((EV_L_30), AEVC_30 * ((EV_Lsat / EV_L_30) + ((EV_L_30 - EV_Lsat) / (10.0 * EV_L_30 * (EV_L_30 + 1.0)))) * EV_N)
        .add_flow_sample((EV_L_31), AEVC_31 * ((EV_Lsat / EV_L_31) + ((EV_L_31 - EV_Lsat) / (10.0 * EV_L_31 * (EV_L_31 + 1.0)))) * EV_N)
        .add_flow_sample((EV_L_32), AEVC_32 * ((EV_Lsat / EV_L_32) + ((EV_L_32 - EV_Lsat) / (10.0 * EV_L_32 * (EV_L_32 + 1.0)))) * EV_N)
    
    cylinder_head head(
        chamber_volume: CHCC_V * units.cc,
        intake_runner_cross_section_area: CHIPT_A * units.cm2,
        intake_runner_volume: CHIP_V * units.cc,
        exhaust_runner_cross_section_area: CHEPT_A * units.cm2,
        exhaust_runner_volume: CHEP_V * units.cc,
        
        intake_port_flow: intake_flow,
        exhaust_port_flow: exhaust_flow,
        intake_camshaft: intake_camshaft,
        exhaust_camshaft: exhaust_camshaft,
        flip_display: flip_display
    )
}