    label IV_L_27(IV_Lsat * 27.0 / 16.0)    // Mathematical dependence. Do not tamper. //
    label IV_L_28(IV_Lsat * 28.0 / 16.0)    // Mathematical dependence. Do not tamper. //
    label IV_L_29(IV_Lsat * 29.0 / 16.0)    // Mathematical dependence. Do not tamper. //
    label IV_L_30(IV_Lsat * 30.0 / 16.0)    // Mathematical dependence. Do not tamper. //
    label IV_L_31(IV_Lsat * 31.0 / 16.0)    // Mathematical dependence. Do not tamper. //
    label IV_L_32(IV_Lsat * 32.0 / 16.0)    // Mathematical dependence. Do not tamper. //

    label EV_L_1(EV_Lsat  * 1.00 / 16.0)    // Mathematical dependence. Do not tamper. //
    label EV_L_2(EV_Lsat  * 2.00 / 16.0)    // Mathematical dependence. Do not tamper. //
    label EV_L_3(EV_Lsat  * 3.00 / 16.0)    // Mathematical dependence. Do not tamper. //
    label EV_L_4(EV_Lsat  * 4.00 / 16.0)    // Mathematical dependence. Do not tamper. //
    label EV_L_5(EV_Lsat  * 5.00 / 16.0)    // Mathematical dependence. Do not tamper. //
    label EV_L_6(EV_Lsat  * 6.00 / 16.0)    // Mathematical dependence. Do not tamper. //
    label EV_L_7(EV_Lsat  * 7.00 / 16.0)    // Mathematical dependence. Do not tamper. //
    label EV_L_8(EV_Lsat  * 8.00 / 16.0)    // Mathematical dependence. Do not tamper. //
    label EV_L_9(EV_Lsat  * 9.00 / 16.0)    // Mathematical dependence. Do not tamper. //
    label EV_L_10(EV_Lsat * 10.0 / 16.0)    // Mathematical dependence. Do not tamper. //
    label EV_L_11(EV_Lsat * 11.0 / 16.0)    // Mathematical dependence. Do not tamper. //
    label EV_L_12(EV_Lsat * 12.0 / 16.0)    // Mathematical dependence. Do not tamper. //
    label EV_L_13(EV_Lsat * 13.0 / 16.0)    // Mathematical dependence. Do not tamper. //
    label EV_L_14(EV_Lsat * 14.0 / 16.0)    // Mathematical dependence. Do not tamper. //
    label EV_L_15(EV_Lsat * 15.0 / 16.0)    // Mathematical dependence. Do not tamper. //
