    label EV_L_19(EV_Lsat * 19.0 / 16.0)    // Mathematical dependence. Do not tamper. //
    label EV_L_20(EV_Lsat * 10.0 / 16.0)    // Mathematical dependence. Do not tamper. //
    label EV_L_21(EV_Lsat * 21.0 / 16.0)    // Mathematical dependence. Do not tamper. //
