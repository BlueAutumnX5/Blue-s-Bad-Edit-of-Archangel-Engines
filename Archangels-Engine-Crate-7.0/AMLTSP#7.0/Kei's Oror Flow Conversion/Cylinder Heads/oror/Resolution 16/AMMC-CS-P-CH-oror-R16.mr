    label EV_L_32(EV_Lsat * 32.0 / 16.0)    // Mathematical dependence. Do not tamper. //

    label AIVCB(IV_D * 0.98 * IPTV_R * constants.pi / I_Cd)    // Mathematical dependence. Do not tamper. //
    label AIVC_0(AIVCB  * 0.000)     // Mathematical dependence. Do not tamper. //
    label AIVC_1(AIVCB  * IV_L_1)    // Mathematical dependence. Do not tamper. //
    label AIVC_2(AIVCB  * IV_L_2)    // Mathematical dependence. Do not tamper. //
    label AIVC_3(AIVCB  * IV_L_3)    // Mathematical dependence. Do not tamper. //
    label AIVC_4(AIVCB  * IV_L_4)    // Mathematical dependence. Do not tamper. //
    label AIVC_5(AIVCB  * IV_L_5)    // Mathematical dependence. Do not tamper. //
    label AIVC_6(AIVCB  * IV_L_6)    // Mathematical dependence. Do not tamper. //
    label AIVC_7(AIVCB  * IV_L_7)    // Mathematical dependence. Do not tamper. //
    label AIVC_8(AIVCB  * IV_L_8)    // Mathematical dependence. Do not tamper. //
    label AIVC_9(AIVCB  * IV_L_9)    // Mathematical dependence. Do not tamper. //
    label AIVC_10(AIVCB * IV_L_10)   // Mathematical dependence. Do not tamper. //
    label AIVC_11(AIVCB * IV_L_11)   // Mathematical dependence. Do not tamper. //
    label AIVC_12(AIVCB * IV_L_12)   // Mathematical dependence. Do not tamper. //
    label AIVC_13(AIVCB * IV_L_13)   // Mathematical dependence. Do not tamper. //
    label AIVC_14(AIVCB * IV_L_14)   // Mathematical dependence. Do not tamper. //
    label AIVC_15(AIVCB * IV_L_15)   // Mathematical dependence. Do not tamper. //
    label AIVC_16(AIVCB * IV_L_16)   // Mathematical dependence. Do not tamper. //
    label AIVC_17(AIVCB * IV_L_17)   // Mathematical dependence. Do not tamper. //
    label AIVC_18(AIVCB * IV_L_18)   // Mathematical dependence. Do not tamper. //
    label AIVC_19(AIVCB * IV_L_19)   // Mathematical dependence. Do not tamper. //
    label AIVC_20(AIVCB * IV_L_20)   // Mathematical dependence. Do not tamper. //
    label AIVC_21(AIVCB * IV_L_21)   // Mathematical dependence. Do not tamper. //
    label AIVC_22(AIVCB * IV_L_22)   // Mathematical dependence. Do not tamper. //
    label AIVC_23(AIVCB * IV_L_23)   // Mathematical dependence. Do not tamper. //
    label AIVC_24(AIVCB * IV_L_24)   // Mathematical dependence. Do not tamper. //
    label AIVC_25(AIVCB * IV_L_25)   // Mathematical dependence. Do not tamper. //
    label AIVC_26(AIVCB * IV_L_26)   // Mathematical dependence. Do not tamper. //
    label AIVC_27(AIVCB * IV_L_27)   // Mathematical dependence. Do not tamper. //
    label AIVC_28(AIVCB * IV_L_28)   // Mathematical dependence. Do not tamper. //
    label AIVC_29(AIVCB * IV_L_29)   // Mathematical dependence. Do not tamper. //
    label AIVC_30(AIVCB * IV_L_30)   // Mathematical dependence. Do not tamper. //
    label AIVC_31(AIVCB * IV_L_31)   // Mathematical dependence. Do not tamper. //
    label AIVC_32(AIVCB * IV_L_32)   // Mathematical dependence. Do not tamper. //

    label AEVCB(EV_D * 0.98 * EPTV_R * constants.pi / E_Cd)    // Mathematical dependence. Do not tamper. //
    label AEVC_0(AEVCB  * 0.000)     // Mathematical dependence. Do not tamper. //
    label AEVC_1(AEVCB  * EV_L_1)    // Mathematical dependence. Do not tamper. //
    label AEVC_2(AEVCB  * EV_L_2)    // Mathematical dependence. Do not tamper. //
    label AEVC_3(AEVCB  * EV_L_3)    // Mathematical dependence. Do not tamper. //
    label AEVC_4(AEVCB  * EV_L_4)    // Mathematical dependence. Do not tamper. //
    label AEVC_5(AEVCB  * EV_L_5)    // Mathematical dependence. Do not tamper. //
    label AEVC_6(AEVCB  * EV_L_6)    // Mathematical dependence. Do not tamper. //
