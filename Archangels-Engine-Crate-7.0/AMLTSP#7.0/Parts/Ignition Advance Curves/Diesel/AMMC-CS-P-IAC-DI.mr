// Ange The Great Engine Simulator v0.1.14A //
// Engine Simulator Official Discord: https://discord.gg/engine-sim-official //

// Engine part made by Archangel Motors //



// Basic ignition advance curve that mimics mechanical diesel injection advance for use with diesel fuel. Compatible with all AMMC-CS Reciprocating Engines. //


// Installation: Override corresponding parts of code in your engine file with the provided code. //



// Part Start //

    function timing_curve(500 * units.rpm)
    timing_curve
        .add_sample(0 * units.rpm, 0.0 * units.deg)
        .add_sample(500 * units.rpm, 2.5 * units.deg)
        .add_sample(1000 * units.rpm, 5.0 * units.deg)   
        .add_sample(1500 * units.rpm, 10.0 * units.deg)
        .add_sample(2000 * units.rpm, 15.0 * units.deg)
        .add_sample(2500 * units.rpm, 20.0 * units.deg)
	    .add_sample(3000 * units.rpm, 22.5 * units.deg)
	    .add_sample(3500 * units.rpm, 22.5 * units.deg)   
	    .add_sample(4000 * units.rpm, 22.5 * units.deg)
	    .add_sample(4500 * units.rpm, 22.5 * units.deg)   
	    .add_sample(5000 * units.rpm, 22.5 * units.deg)
	    .add_sample(5500 * units.rpm, 22.5 * units.deg)
        .add_sample(6000 * units.rpm, 22.5 * units.deg)   
        .add_sample(6500 * units.rpm, 22.5 * units.deg)
        .add_sample(7000 * units.rpm, 22.5 * units.deg) 

// Part End //