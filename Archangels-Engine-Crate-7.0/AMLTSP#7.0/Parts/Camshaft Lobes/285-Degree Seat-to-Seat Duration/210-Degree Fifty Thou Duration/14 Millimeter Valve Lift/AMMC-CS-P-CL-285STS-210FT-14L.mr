// Ange The Great Engine Simulator v0.1.14A //
// Engine Simulator Official Discord: https://discord.gg/engine-sim-official //

// Engine part made by Archangel Motors //

// Lobe generator made by Oror //
// Discord: ororx //
// Youtube: https://www.youtube.com/@orwhat //



// Camshaft lobes generated with Oror's Lobe Generator. Compatible with all AMMC-CS Reciprocating engines //
// Lobes from different kits can be used together //


// Advertised duration: 285/285 //
// Duration at 0.050in: 210/210 //
// Valve lift: 14.0/14.0 //
// Lobe Separation Angle: Adjustable //
// Camshaft Advance: Adjustable //


// Installation: Override corresponding parts of code in your engine file with the provided code //



// Part Start //

label IV_L(14.0)    // Intake valve lift. Units: millimeters. Override is impossible, do not tamper. //
label EV_L(14.0)    // Exhaust valve lift. Units: millimeters. Override is impossible, do not tamper. //



label CSL_Salpha(110.0 * units.deg)    // Camshaft lobe separation angle. Units: Degrees. This line has no counterpart in the default code. Add it anywhere in the valvetrain parameters. //
label CS_AR(0.0 * units.deg)    // Camshaft advance/retard. Units: Degrees of crankshaft rotation. This line has no counterpart in the default code. Add it anywhere in the valvetrain parameters. //

label ID(210.0 * units.deg)    // Total intake duration at 0.050 inches of intake valve lift. Calculated automatically. Units: degrees of crankshaft rotation. Do not tamper. //
label ED(210.0 * units.deg)    // Total exhaust duration at 0.050 inches of exhaust valve lift. Calculated automatically. Units: degrees of crankshaft rotation. Do not tamper. //

label IV_O(-1.0 * ((CSL_Salpha - CS_AR) - (ID / 2.0)))    // Intake valve opening event. Measured at 0.050 inches of intake valve lift. Units: degrees of crankshaft rotation before top dead center. Override is impossible, do not tamper. //
label IV_C(((CSL_Salpha - CS_AR) + (ID / 2.0)) - (180 * units.deg))    // Intake valve closing event. Measured at 0.050 inches of intake valve lift. Units: degrees of crankshaft rotation after bottom dead center. Override is impossible, do not tamper. //

label EV_O(((CSL_Salpha + CS_AR) + (ED / 2.0)) - (180 * units.deg))    // Exhaust valve opening event. Measured at 0.050 inches of exhaust valve lift. Units: degrees of crankshaft rotation before bottom dead center. Override is impossible, do not tamper. //
label EV_C(-1.0 * ((CSL_Salpha + CS_AR) - (ED / 2.0)))    // Exhaust valve closing event. Measured at 0.050 inches of exhaust valve lift. Units: degrees of crankshaft rotation after top dead center. Override is impossible, do not tamper. //

label ID_delta(0.0)    // Difference between intake duration measured at 0.050 inches or lift specified in Oror's Lobe Generator parameters and 0.001 millimeters of intake valve lift. Units: degrees of crankshaft rotation. //    // Optional 75.0 Degrees override for this kit of camshaft lobes. //
label ED_delta(0.0)    // Difference between exhaust duration measured at 0.050 inches or lift specified in Oror's Lobe Generator parameters and 0.001 millimeters of intake valve lift. Units: degrees of crankshaft rotation. //    // Optional 75.0 Degrees override for this kit of camshaft lobes. //



/*
{
  "cam_cfg": {
    "es_version": "0.1.14a",
    "resolution": 57,
    "intake_volume": 0.15,
    "exhaust_volume": 0.15,
    "intake_at_lift": 1.27,
    "exhaust_at_lift": 1.27,
    "intake_trim": 0.95,
    "exhaust_trim": 0.95,
    "intake_sigma": 1.089,
    "exhaust_sigma": 1.089,
    "intake_base_mult": 1.5,
    "exhaust_base_mult": 1.5,
    "intake_cos": true,
    "exhaust_cos": true,
    "equal_base_radius": true,
    "ramp_steepness": 5.0,
    "ramp_position": 0.914,
    "lift_significant_fraction": 100.0,
    "roller_tappet_radius": 0.1
  }
}
*/



