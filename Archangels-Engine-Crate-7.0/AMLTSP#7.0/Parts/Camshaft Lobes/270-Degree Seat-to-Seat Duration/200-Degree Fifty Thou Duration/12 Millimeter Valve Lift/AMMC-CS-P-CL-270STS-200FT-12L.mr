{
  "cam_cfg": {
    "es_version": "0.1.14a",
    "resolution": 51,
    "intake_volume": 0.24,
    "exhaust_volume": 0.24,
    "intake_at_lift": 1.27,
    "exhaust_at_lift": 1.27,
    "intake_trim": 0.95,
    "exhaust_trim": 0.95,
    "intake_sigma": 1.08,
    "exhaust_sigma": 1.08,
    "intake_base_mult": 1.5,
    "exhaust_base_mult": 1.5,
    "intake_cos": true,
    "exhaust_cos": true,
    "equal_base_radius": false,
    "ramp_steepness": 5.0,
    "ramp_position": 0.281,
    "lift_significant_fraction": 100.0,
    "roller_tappet_radius": 0.1
  }
}
*/



