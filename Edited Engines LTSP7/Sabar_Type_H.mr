// Ange The Great Engine Simulator v0.1.14A //
// Engine Simulator Official Discord: https://discord.gg/engine-sim-official //

// Engine template made by Archangel Motors //

// Badly edited by BlueAutumnX5 //
// Youtube: Dheo Tiramisu //
// Yes, I'm Indonesian //

// A HIT AND MISS ENGINE. One cylinder, 997 cc, governed to 500 rpm, driving  //
// a workshop line shaft by flat belt off its own flywheel. Built new on the  //
// pristine AMLTSP#7.0 1-cylinder template rather than edited from another    //
// engine, per ENGINE-NOTES.md section 1.                                     //
//                                                                            //
// WHAT A HIT AND MISS ENGINE IS, AND WHY ENGINE SIMULATOR CAN ACTUALLY DO IT //
//                                                                            //
// Before there were throttles worth the name, stationary engines held their  //
// speed with a flyball governor that did something startlingly crude: when    //
// the engine ran fast enough, the governor simply STOPPED IT FIRING. It      //
// coasted on its flywheels - one revolution, five, fifteen - until it had    //
// slowed enough for the governor to drop back in, then it fired once or      //
// twice, sped up, and was cut off again. Hence the name, and hence the       //
// sound: bark ... ... ... ... bark bark ... ... ... ... bark. An engine      //
// that is idle most of the time and flat out the rest of it.                 //
//                                                                            //
// Every other engine in this repo is a fight against something the simulator //
// cannot model. This one is the opposite, and it is a genuinely lucky fit.   //
// Read src/ignition_module.cpp and the rev limiter is NOT a fixed-length     //
// spark cut. The timer is re-armed to the full duration on every single tick //
// the engine is above the limit, and the spark is only allowed back          //
// LICO_t seconds AFTER speed has fallen below it again:                      //
//                                                                            //
//     if (m_enabled && m_revLimitTimer == 0) { ...spark... }                 //
//     m_revLimitTimer -= dt;                                                 //
//     if (fabs(v_theta) > m_revLimit) m_revLimitTimer = m_limiterDuration;   //
//                                                                            //
// That is not a rev limiter. That is a governor with hysteresis - cut until  //
// slow enough, then a dwell before the igniter is let back in - which is     //
// precisely the mechanism of a spark-cut hit and miss governor. So the       //
// central feature of this engine is not a stand-in for anything. It is the   //
// real behaviour, falling out of the model for free. E_omegamax is the       //
// governed speed and LICO_t is the length of the miss.                       //
//                                                                            //
// (On the provenance of that code, because it matters and because it is      //
// easy to get wrong. The binary everything here was tuned against is         //
// 0.1.14a, but no 0.1.14a SOURCE is published anywhere: ange-yaghi's repo    //
// stops at 0.1.12a, and Engine-Simulator/engine-sim-community-edition, which //
// is where the 0.1.14a download lives, contains only the release zip, docs   //
// and a tutorial - no src/ tree at all. So the snippet above is read from    //
// 0.1.12a. Two things say it is still the right code. It is byte-identical   //
// between ange-yaghi master and the bobsayshilol fork, and the release notes //
// for the two versions in between touch nothing near it: 0.1.13a is physics  //
// performance plus fluid_simulation_steps and max_sle_solver_steps, and      //
// 0.1.14a is packaging, dependencies and a frame-sync algorithm. On top of   //
// that the behaviour was confirmed by measurement in the actual 0.1.14a      //
// build, which outranks reading any source anyway. No decompiler needed.)    //
//                                                                            //
// THE OTHER HALF: THE ATMOSPHERIC INTAKE VALVE                               //
//                                                                            //
// The intake valve on an engine like this has no cam, no pushrod and no lobe //
// on the camshaft. It is held shut by a light spring and pulled open by the  //
// piston's own suction. engine-sim has no way to express a valve that opens  //
// itself, so it is modelled by putting the events where the physics would    //
// put them: it opens AFTER top dead centre (IV_O is negative - there is no    //
// vacuum to open it before that), it shuts at the bottom of the stroke, and  //
// the overlap is EXACTLY ZERO, because a self-opening valve cannot be asked  //
// to open against a cylinder still full of exhaust. See IV_O, IV_C and EV_C. //
//                                                                            //
// There is also no throttle - IM_IT is 0.0, which pins the plate wide open   //
// and makes the throttle keys inert. That is correct and not a shortcut:     //
// the governor is the only speed control the engine has.                     //
//                                                                            //
// MEASURED STATE, cold start, this file as committed. Every number below     //
// was read off the tachometer on a full application restart, never through   //
// RELOAD (ENGINE-NOTES.md 5f).                                               //
//                                                                            //
//   No load:   fires, then coasts about 17 revolutions, and repeats.         //
//              Speed swings roughly 456 - 575 rpm around the governed 500.   //
//              Coast-down measured at 60-62 rpm/s.                           //
//   Gear 3:    453 - 566 rpm, still hit-and-missing under load.              //
//   Gear 5:    468 - 581 rpm, still hit-and-missing on the tallest step.     //
//   Output:    ~21 Nm, ~1.4 hp, 2.6 bar BMEP - see E_Nmax for how that was   //
//              measured, because it was NOT with the dynamometer.            //
//   Drag:      10.7 Nm total during a miss - 4.6 friction, 6.1 pumping.      //
//                                                                            //
// Note the engine overshoots its own governed speed by up to 15 percent.     //
// That is not a fault in the limiter: v_theta is the INSTANTANEOUS crank     //
// speed, and a single cylinder this big with this much stroke speeds up      //
// hard on the power stroke and slows on compression, so the limiter trips    //
// on a within-cycle peak rather than on the mean. On a big slow single the   //
// governed speed is a band, not a line.                                      //



// Imports Start //

import "engine_sim.mr"

units units()
constants constants()

impulse_response_library ir_lib()

// Imports End //



// Simulation Parameters Start //

label SIM_f(22050)    // Simulation frequency. Units: Hertz. //
label SIM_SLESd(128)    // System of linear equations solver maximum steps. //
label SIM_FSd(8)    // Fluid simulation steps. //
label SIM_MCf(0.0)    // Misfire correction factor. Shifts the point where "ignition advance = firing interval" misfire bug occurs. Units: degrees. //
label AUDIO_CONV(1.0)    // Audio convolution. //
label AUDIO_HFG(0.01)    // Audio high frequency gain. //
label AUDIO_HFN(1.0)    // Audio high frequency noise. //
label AUDIO_LFN(1.0)    // Audio low frequency noise. //

// Simulation Parameters End //



// Main Parameters Start //

label EC_N(1.0)    // Cylinder amount. Does not create cylinders automatically. //
label ECB_N(1.0)    // Cylinder bank amount. Does not create cylinder banks automatically. //

label E_B(100.0)    // Cylinder bore diameter. Units: millimeters. //
label E_S(127.0)    // Piston stroke. Units: millimeters. Exactly 5.00 inches - these engines were laid out in inches, and a 5 inch stroke on a roughly 4 inch bore is the commonest size in the whole class. With a 100 mm bore that comes to 997.5 cc, so the sim reads it as 1.0 L. Stroke/bore is 1.27: heavily undersquare, which is the point. Mean piston speed at the governed 500 rpm is 2.12 m/s, about a fifth of a modern engine, and that is why the thing can be built out of cast iron and babbitt and run for eighty years. //

label E_omegamax(500.0)    // Maximum engine speed. Units: Revolutions per minute. This is not a redline, it is the GOVERNED speed - the point at which the governor throws out and cuts the ignition. See the header. Everything downstream of this label wants checking (ENGINE-NOTES.md 3): it feeds TACHO_REDLINE, DYN_RPMmax, the E_Nmax torque estimate and the ignition cut, and all four are pinned or overridden explicitly below rather than left to alias it. //
label LICO_t(1.0)    // Engine speed limiter ignition cut-off duration. Units: seconds. THE defining label of this engine, and the one that took measuring to get right. Read ignition_module.cpp and the limiter is not a fixed-length cut: the timer is re-armed to the full duration on EVERY tick the engine is over the limit, and the spark only comes back LICO_t seconds after speed has fallen back below it. That is a hysteresis governor, not a rev limiter, and it is exactly how a hit-and-miss engine behaves. So this number is the length of the MISS. || WHY 1.0 AND NOT 2.0: it was 2.0 first, which gave a gorgeous unloaded cadence - a coast of about 13 revolutions - and then fell over the moment the engine was put under load. The trap is that the timer re-arms on any excursion above the limit and then demands LICO_t seconds of CONTINUOUS running below it, so every overshoot buys a mandatory blackout of that length. Unloaded the flywheel coasts through it happily. Loaded, the load drags the engine to a standstill inside those two seconds and it can never earn its spark back: it fires once, dies, and looks like it has a fuelling fault. A real flyball governor re-engages on SPEED and does it instantly - the fixed timer is the one place engine-sim genuinely mismodels this mechanism, and it only shows up under load. Measured drag during a miss is 10.7 Nm (see FRIC_m), which is 62 rpm/s, so 1.0 s gives roughly 60 rpm of droop and still leaves the engine able to catch itself when it is working. //
label TACHO_REDLINE(500.0)    // Redline. Determines at what speed the redline is drawn on the tachometer. Units: revolutions per minute. Pinned to a literal rather than aliasing E_omegamax, per the lesson in ENGINE-NOTES.md 3. There is no redline on an engine like this - nothing about 500 rpm is dangerous, the crank would happily turn twice that. The mark is the governed speed, i.e. the speed the governor will not let it pass, and watching the needle bounce down from that line and back up to it is the whole show. //

label FRIC_m(3.0)    // Global engine friction multiplier. Not a template label - added, as on the Kaestro Boyotte. engine-sim derives friction from bearing drag alone (a 0.0015 coefficient on component masses) and ignores piston rings, valvetrain and oil pumping, so it comes out 5-10x light (ENGINE-NOTES.md 5d). Untouched this engine computes 1.54 Nm, which is 0.19 bar FMEP; a splash-lubricated cast-iron engine on plain bearings is nearer 0.5-0.8. x3.0 gives 4.61 Nm and 0.58 bar. CHECKED AGAINST MEASUREMENT: the engine coasts at 62 rpm/s during a miss, and with 1.643 kg.m2 of rotating inertia that is 10.7 Nm of total drag - so friction is 4.6 of it and pumping the other 6.1, which is a sensible split for a wide-open-throttle engine with nothing to throttle. Do not raise this much further: at x6 the friction alone would eat nearly half the 21 Nm the engine makes. On a hit-and-miss this is not a cosmetic number - it sets how fast the engine coasts during a miss, and so how far the speed droops and how long the gap between hits is. //

label IGN_ADV(20.0)    // Igniter trip angle. Units: degrees before top dead centre. ONE number for the whole rev range - see the timing curve at the bottom of the file. A starting point, to be measured: at 500 rpm one degree is only 0.33 ms, and a big low-compression chamber with almost no charge motion burns slowly, so this may want to be a good deal more than a modern engine would use. //

label SM_omega(250.0)    // Starter speed. Units: Revolutions per minute. There is no starter motor: you start these by heaving on a flywheel spoke, or on a crank handle, and letting the 47 kg of iron carry the piston over compression. 250 rpm is a hard pull. It is deliberately kept well under the 500 rpm governed speed so the starter cannot itself trip the governor - if this were set to 500 the engine would appear to run without ever firing. //
label SM_Ftq(250.0)    // Starter torque. Units: newton meters. Sized to turn the engine over compression rather than copied from the template. At 4.0:1 a motoring peak of roughly 6.5 bar acts on a 78.5 cm2 piston, which is about 160 Nm at the crank at the worst angle; 250 leaves margin. In life this is a human and a flywheel, not a motor. //

// Main Parameters End //



// Displacements //

label EC_Vcc((((((E_B / 2.0) * (E_B / 2.0)) * constants.pi) * E_S) / 1000.0))    // Single cylinder displacement. Calculated automatically. Units: cubic centimeters. Do not tamper. //
label EC_Vci(EC_Vcc * 0.061024)    // Single cylinder displacement. Calculated automatically. Units: cubic inches. Do not tamper. //
label E_Dcc(EC_Vcc * EC_N)    // Engine displacement. Calculated automatically. Units: cubic centimeters. Do not tamper. //
label E_Dci(EC_Vci * EC_N)    // Engine displacement. Calculated automatically. Units: cubic inches. Do not tamper. //

// Displacements //



// Piston Parameters Start //

label PCH_d((E_S / E_B) * 4.0)    // Piston compression height divisor. Determines the "Piston stroke/piston compression height" ratio. Calculated automatically, but can be overridden. //
label PCH_H(E_S / PCH_d)    // Piston compression height. Calculated automatically, but can be overridden. Units: millimeters. //

label PT_H(PCH_H / 2.0)    // Piston top thickness. Calculated automatically, override only if you are a professional. Units: millimeters. //
label PT_V((((E_B * E_B) * constants.pi) * PT_H) / 4000.0)    // Piston top volume. Calculated automatically. Units: cubic centimeters. Do not tamper. //

label PS_H((PCH_H * 2.5) - PT_H)    // Piston skirt height. Calculated automatically, override only if you are a professional. Units: millimeters. //
label PSI_D(E_B - (2.0 * (E_B / 15.0)))    // Piston skirt internal diameter. Calculated automatically, override only if you are a professional. Units: millimeters. //
label PSID_V((((PSI_D * PSI_D) * constants.pi) * PS_H) / 4000.0)    // Piston skirt internal diameter volume. Calculated automatically. Units: cubic centimeters. Do not tamper. //
label PSOD_V((((E_B * E_B) * constants.pi) * PS_H) / 4000.0)    // Piston skirt outer diameter volume. Calculated automatically. Units: cubic centimeters. Do not tamper. //
label PS_V(PSOD_V - PSID_V)    // Piston skirt volume. Calculated automatically. Units: cubic centimeters. Do not tamper. //

label P_rho(7.15)    // Piston material density. Units: grams per cubic centimeter //  
label P_Mm((0.15 * P_rho) / (P_rho / 7.15))    // Piston mass multiplier. Prevents the piston mass from being too low if light materials are used. Calculated automatically, override only if you are a professional. //
label P_V(PT_V + PS_V)    // Piston volume. Calculated automatically. Units: cubic centimeters. Do not tamper. //                                             
label P_M(P_V * P_rho * P_Mm)    // Piston mass. Calculated automatically, but can be overridden. Units: grams. //

label PR_C(100.0)    // Piston rings condition. Percentage. Determines the amount of piston rings blowby. Do not use values less than 0.01 //
label PRW_L(E_B / 22.0)    // Piston rings radial wall thickness. Calculated automatically, override only if you are a professional. Units: millimeters. //
label PRG_L(E_B * 0.0035)    // Piston rings gap. Calculated automatically, override only if you are a professional. Units: millimeters. //
label PRG_alpha((PRG_L * 360.0) / (2.0 * constants.pi * (E_B / 2.0)))    // Piston rings gap central angle. Calculated automatically. Units: degrees. Do not tamper. //
label PRGOS_A((((E_B / 2.0) * (E_B / 2.0)) * (PRG_alpha / 2.0)) / 100.0)    // Piston rings gap outer sector area. Calculated automatically. Units: square centimeters. Do not tamper. //
label PRGIS_A(((((E_B - (PRW_L * 2.0)) / 2.0) * ((E_B - (PRW_L * 2.0)) / 2.0)) * (PRG_alpha / 2.0)) / 100.0)    // Piston rings gap inner sector area. Calculated automatically. Units: square centimeters. Do not tamper. //
label PRG_A(PRGOS_A - PRGIS_A)    // Piston rings gap area. Calculated automatically. Units: square centimeters. Do not tamper. //
label PR_Bm(1.0 / PR_C)    // Piston rings blowby multiplier. Prevents the blowby from being too high by default. Calculated automatically, overridde only if you are a professional. //
label PR_B((PRG_A * 0.155 * 146.0) * PR_Bm)    // Piston rings blowby. Calculated automatically, but can be overridden. Units: cubic feet per minute at 28 inches of water pressure drop. //

// Piston Parameters End //



// Connecting Rod Parameters Start //

label CR_R(1.75)    // Connecting rod ratio. Determines the "connecting rod length/stroke" ratio. //
label CR_L(E_S * CR_R)    // Connecting rod length. Calculated automatically, but can be overridden. Units: millimeters. //
label CR_T(E_B / 3.5)    // Connecting rod thickness. Calculated automatically, override only if you are a professional. Units: millimeters. //
label CR_W(E_B / 3.0)    // Connecting rod width. Calculated automatically, override only if you are a professional. Units: millimeters. //
label CR_V((CR_L * CR_T * CR_W) / 1000.0)    // Connecting rod volume. Calculated automatically. Units: cubic centimeters. Do not tamper. //

label CR_rho(7.15)    // Connecting rod material density. Units: grams per cubic centimeter //
label CR_Mm((0.15 * CR_rho) / (CR_rho / 7.15))    // Connecting rod mass multiplier. Prevents the connecting rod mass from being too low if light materials are used. Calculated automatically, override only if you are a professional. //
label CR_M(CR_V * CR_rho * CR_Mm)    // Connecting rod mass. Calculated automatically, but can be overridden. Units: grams. //

label CR_MOI(((1.0 / 12.0) * (CR_M / 1000.0)) * (((CR_L / 1000.0) * (CR_L / 1000.0)) + ((CR_W / 1000.0) * (CR_W / 1000.0))))    // Connecting rod moment of inertia. Calculated automatically, override only if you are a professional. Units: kilograms times meters squared. //
label CR_MOIC((((1.0 / 12.0) * (CR_M / 1000.0)) * ((4.0 * (((CR_L + CT_L) / 1000.0) * ((CR_L + CT_L) / 1000.0))) + ((CR_W / 1000.0) * (CR_W / 1000.0)))) * EC_N)    // Connecting rod moment of inertia applied to crankshaft. Calculated automatically, override only if you are a professional. Units: kilograms times meters squared. //

// Connecting Rod Parameters End //



// Crankshaft Parameters Start //

label CT_L(E_S / 2.0)    // Crankshaft throw. Calculated automatically. Units: millimeters. Do not tamper. //

label C_rho(7.15)    // Crankshaft material density. Units: grams per cubic centimeter. //
label C_Mm((0.5 * C_rho) / (C_rho / 7.15))    // Crankshaft mass multiplier. Prevents the crankshaft mass from being too low if light materials are used. Calculated automatically, override only if you are a professional. //

label CRJ_L((CR_T * EC_N) / ECB_N)    // Crankshaft rod journal(s) total length. Calculated automatically, override only if you are a professional. Units: millimeters. //
label CRJ_D(CR_W)    // Crankshaft rod journal diameter. Calculated automatically, override only if you are a professional. Units: millimeters. //
label CRJ_V(((constants.pi * (CRJ_D * CRJ_D)) * CRJ_L) / 4000.0)    // Crankshaft rod journal(s) total volume. Calculated automatically. Units: cubic centimeters. Do not tamper. //
label CRJ_MOI(((((CRJ_V * C_rho) / (EC_N / ECB_N)) / 1000.0) * ((CT_L / 1000.0) * (CT_L / 1000.0))) * (EC_N / ECB_N))    // Crankshaft rod journal(s) moment of inertia. Calculated automatically, override only if you are a professional. Units: kilograms times meters squared. //

label CW_T(CRJ_L)    // Crankshaft web(s) total thickness. Calculated automatically, override only if you are a professional. Units: millimeters. //
label CW_H(CT_L + CRJ_D)    // Crankshaft web height. Calculated automatically, override only if you are a professional. Units: millimeters. //
label CW_V((CRJ_D * CW_H * CW_T) / 1000.0)    // Crankshaft web(s) total volume. Calculated automatically, override only if you are a professional. //
label CW_MOI(((1.0 / 12.0) * (((CW_V * C_rho) / ((EC_N / ECB_N) * 2.0)) / 1000.0) * (4.0 * ((CW_H / 1000.0) * (CW_H / 1000.0)) + ((CRJ_D / 1000.0) * (CRJ_D / 1000.0)))) * ((EC_N / ECB_N) * 2.0))    // Crankshaft web(s) moment of inertia. Calculated automatically, override only if you are a professional. Units: kilograms times meters squared. //

label CMB_N((EC_N / ECB_N) + 1.0)    // Crankshaft main bearings amount. Calculated automatically, but can be overridden. //
label CMB_L(CR_T * CMB_N)    // Crankshaft main bearings total length. Calculated automatically, override only if you are a professional. Units: millimeters. //
label CMB_D(CR_W)    // Crankshaft main bearing diameter. Calculated automatically, override only if you are a professional. Units: Millimeters. //
label CMB_V(((constants.pi * (CMB_D * CMB_D)) * CMB_L) / 4000.0)    // Crankshaft main bearings total volume. Calculated automatically. Units: cubic centimeters. Do not tamper. //
label CMB_MOI((1.0 / 2.0) * (((CMB_V * C_rho) / 1000.0) * ((CMB_D / 2000.0) * (CMB_D / 2000.0))))    // Crankshaft main bearings moment of inertia. Calculated automatically, override only if you are a professional. Units: kilograms times meters squared. //

label CC_H(CT_L)    // Crankshaft counterweight height. Calculated automatically, override only if you are a professional. Units: millimeters. //
label CC_W(CR_W / 2.0)    // Crankshaft counterweight width. Calculated automatically, override only if you are a professional. Units: millimeters. //
label CC_Mm(0.5)    // Crankshaft counterweight mass multiplier. Determines the "crankshaft counterweight mass/piston and connecting rod mass". Value of 0.5 for anything that does not feature a 90-degree bank separation angle is recommended. //
label C_uM((CRJ_V + CW_V + CMB_V) * C_rho * C_Mm)    // Crankshaft unbalanced mass. Calculated automatically, override only if you are a professional. Units: grams. //
label CC_M(C_uM + ((P_M + CR_M) * CC_Mm))    // Crankshaft counterweight(s) total mass. Calculated automatically, override only if you are a professional. Units: grams. //
label CC_MOI(((1.0 / 12.0) * ((CC_M / 1000.0) / ((EC_N / ECB_N) * 2.0)) * (4.0 * ((CC_H / 1000.0) * (CC_H / 1000.0)) + ((CC_W / 1000.0) * (CC_W / 1000.0)))) * ((EC_N / ECB_N) * 2.0))    // Crankshaft counterweight(s) moment of inertia. Calculated automatically, override only if you are a professional. Units: kilograms times meters squared. //

label C_M(C_uM + CC_M)    // Crankshaft mass. Calculated automatically, but can be overridden. Units: grams. //
label C_MOI(CW_MOI + CRJ_MOI + CC_MOI + CMB_MOI)    // Crankshaft moment of inertia. Calculated automatically, only override if you are a professional. Units: kilograms times meters squared. //
label C_Fmu(((C_M / 1000.0) * 9.80665) * (0.0015 * CMB_N))    // Crankshaft friction. Calculated automatically, only override if you are a professional. Units: newton meters. //

label CP_D(E_S * 0.75)    // Crankshaft pulley diameter. Calculated automatically, but can be overridden. Units: millimeters. //
label CP_T(E_B * 0.33)    // Crankshaft pulley thickness. Calculated automatically, but can be overridden. Units: millimeters. //
label CP_V(((constants.pi * (CP_D * CP_D)) * CP_T) / 4000.0)    // Crankshaft pulley volume. Calculated automatically. Units: cubic centimeters. Do not tamper. //
label CP_rho(7.15)    // Crankshaft pulley material density. Units: grams per cubic centimeter. //
label CP_Mm((0.5 * CP_rho) / (CP_rho / 7.15))    // Crankshaft pulley mass multiplier. Prevents the crankshaft pulley mass from being too low if light materials are used. Calculated automatically, override only if you are a professional. //
label CP_M(CP_V * CP_rho * C_Mm)    // Crankshaft pulley mass. Calculated automatically, but can be overridden. Units: grams. //
label CP_MOI((1.0 / 2.0) * (CP_M / 1000.0) * ((CP_D / 2000.0) * (CP_D / 2000.0)))    // Crankshaft pulley moment of inertia. Calculated automatically, override only if you are a professional. Units: kilograms times meters squared. //
label CP_Fmu(((CP_M / 1000.0) * 9.80665) * 0.0015)    // Crankshaft pulley friction. Calculated automatically, override only if you are a professional. Units: newton meters. //

label CHB_M(CC_M / EC_N)    // Crankshaft harmonic balancer mass. Calculated automatically, but can be overridden. Units: grams. //
label CHB_MOI((CHB_M / 1000.0) * ((CP_D / 2000.0) * (CP_D / 2000.0)))   // Crankshaft harmonic balancer moment of inertia. Calculated automatically, override only if you are a professional. Units: kilograms times meters squared. //
label CHB_Fmu(((CHB_M / 1000.0) * 9.80665) * 0.0015)    // Crankshaft harmonic balancer friction. Calculated automatically, override only if you are a professional. Units: newton meters. //

// Crankshaft Parameters End //



// Flywheel Parameters Start //

label FW_D(500.0)    // Flywheel diameter. Calculated automatically, but can be overridden. Units: millimeters. The template formula (E_S * 2.5) gives 318 mm, which is a car flywheel. A 1.5-2 hp stationary engine of this era carries a PAIR of spoked flywheels around 20 inches across - 500 mm - and they are half the weight of the whole engine. They are also the belt pulleys: the face of the flywheel is flat and the flat belt to the line shaft runs directly on it, which is why W_D below is set to this same diameter. //
label FW_T(31.0)    // Flywheel thickness. Calculated automatically, but can be overridden. Units: millimeters. Chosen so that the sim's single solid disc comes out at 46.7 kg, which is the mass of the real PAIR of flywheels (roughly 23 kg each). Two wheels are modelled as one because the crankshaft node accepts one flywheel; they sit either side of the crank and their inertias simply add. Note the sim computes the moment of inertia of a SOLID disc, while a real flywheel is a spoked wheel with its mass concentrated in the rim, so 1.46 kg.m2 here is if anything conservative against the real article. //
label FW_V(((constants.pi * (FW_D * FW_D)) * FW_T) / 4000.0)    // Flywheel volume. Calculated automatically. Units: cubic centimeters. Do not tamper. //
label FW_rho(7.15)    // Flywheel material density. Units: grams per cubic centimeter. //
label FW_Mm((0.15 * FW_rho) / (FW_rho / 7.15))    // Flywheel mass multiplier. Prevents the flywheel mass from being too low if lighter materials are used. Calculated automatically, override only if you are a professional. //
label FW_M(FW_V * FW_rho * FW_Mm)    // Flywheel mass. Calculated automatically, but can be overridden. Units: grams. //
label FW_MOI((1.0 / 2.0) * ((FW_M / 1000.0) * ((FW_D / 2000.0) * (FW_D / 2000.0))))    // Flywheel moment of inertia. Calculated automatically, override only if you are a professional. Units: kilograms times meters squared. //
label FW_Fmu(((FW_M / 1000.0) * 9.80665) * 0.0015)    // Flywheel friction. Calculated automatically, override only if you are a professional. Units: newton meters. //

// Flywheel Parameters End //



// Valvetrain Parameters Start //

label IV_N(1.0)    // Intake valve amount. //
label IV_D(38.0)    // Intake valve diameter. Units: millimeters. A literal, not the template's E_B/2 (which would be 50 mm). 38 mm is 38 percent of the bore, small by modern standards and correct here for two reasons: the engine turns 500 rpm and never needs the flow, and an atmospheric intake valve has to be light enough for cylinder vacuum alone to lift it against its spring. Same size as the exhaust valve, which is not laziness - these engines really did use one valve part number for both ports, because it was cheaper to make one pattern. //
label IV_L(6.0)    // Intake valve lift. Units: millimeters. Lower than the exhaust's 8 mm, and for a physical reason: nothing pushes this valve. It is pulled open by the pressure difference across it and it opens exactly as far as the vacuum can drag it against the spring, which is not far. 6 mm on a 38 mm valve is L/D 0.16. //
label IV_O(-5.0 * units.deg)    // Intake valve opening event. Measured at 0.050 inches of intake valve lift. Units: degrees of crankshaft rotation before top dead center. If the valve opens after top dead center, use negative value. NEGATIVE, i.e. the valve opens 5 degrees AFTER top dead centre. This is the atmospheric (automatic) intake valve, which has no cam, no pushrod and no lobe on the camshaft at all - it is held shut by a light spring and sucked open by the piston. It therefore cannot open before TDC, because before TDC there is nothing to suck it: the cylinder is still full of exhaust at or above atmospheric pressure. The valve has to wait for the piston to start down and build some vacuum. engine-sim has no way to model a valve that opens itself, so the cam profile here is shaped to land the events where the real physics would put them. //
label IV_C(10.0 * units.deg)    // Intake valve closing event. Measured at 0.050 inches of intake valve lift. Units: degrees of crankshaft rotation after bottom dead center. If the valve closes before bottom dead center, use negative value. An atmospheric valve slams shut the moment the pressure difference reverses, which is essentially at the bottom of the stroke - it cannot be held open into the compression stroke the way a cammed valve is, because the rising piston pushes it onto its seat. 10 degrees is the little that inertia in the valve and spring buys. Total intake duration is therefore 185 degrees, very short, and short for a reason rather than as a tuning choice. //
label ID(IV_O + (180.0 * units.deg) + IV_C)    // Total intake duration at 0.050 inches of intake valve lift. Calculated automatically. Units: degrees of crankshaft rotation. Do not tamper. //  
label ID_delta(0.0)    // Difference between intake duration measured at 0.050 inches and 0.001 millimeters of intake valve lift. Units: degrees of crankshaft rotation. //
label IV_A(((constants.pi * ((IV_D * 0.98) * (IV_D * 0.98))) / 400.0) * IV_N)    // Intake valve(s) flow cross-sectional area. Calculated automatically, override only if you are a professional. Units: square centimeters. //
label IV_Qmax(IV_A * 0.155 * 146.0)    // Intake valve(s) flow area theoretical maximum volumetric flow rate. Calculated automatically. Units: cubic feet per minute at 28 inches of water pressure drop. Do not tamper. //


label EV_N(1.0)    // Exhaust valve amount. //
label EV_D(38.0)    // Exhaust valve diameter. Units: millimeters. The same 38 mm casting as the intake - see IV_D. This is the only valve on the engine that is actually driven by the camshaft. //
label EV_L(8.0)    // Exhaust valve lift. Units: millimeters. More than the intake's 6 mm because this one has a cam and a pushrod behind it and can be opened as far as the designer likes. It also has to do more work: it has to dump a full cylinder of burnt gas against a governor that may leave it several revolutions to do nothing at all. //
label EV_O(40.0 * units.deg)    // Exhaust valve opening event. Measured at 0.050 inches of exhaust valve lift. Units: degrees of crankshaft rotation before bottom dead center. If the valve opens after bottom dead center, use negative value. Opens early, which costs a little of the power stroke and buys a clean blowdown at a speed where there is very little time pressure. //
label EV_C(5.0 * units.deg)    // Exhaust valve closing event. Measured at 0.050 inches of exhaust valve lift. Units: degrees of crankshaft rotation after top dead center. If the valve closes before top dead center, use negative value. Set to +5 against the intake's -5, which makes the overlap EXACTLY ZERO: the exhaust valve shuts at the same crank angle the intake starts to open. That is not a tuning preference, it is forced by the atmospheric intake. Any overlap at all would mean asking the intake valve to be open while the cylinder still has exhaust pressure in it, and a valve with no cam behind it would simply stay shut - or worse, get blown backwards into the mixer. Zero overlap is the constraint that the whole valvetrain is built around. //
label ED(EV_O + (180.0 * units.deg) + EV_C)    // Total exhaust duration at 0.050 inches of exhaust valve lift. Calculated automatically. Units: degrees of crankshaft rotation. Do not tamper. //   
label ED_delta(0.0)    // Difference between exhaust duration measured at 0.050 inches and 0.001 millimeters of exhaust valve lift. Units: degrees of crankshaft rotation. // 
label EV_Oatdc(((180.0 * units.deg) - (EV_O + (ED_delta / 2.0))) / units.deg)    // Exhaust valve closing event. Measured at 0.001 millimeters of exhaust valve lift. Calculated automatically. Units: degrees of crankshaft rotation after top dead center. Do not tamper. //
label EV_A(((constants.pi * ((EV_D * 0.98) * (EV_D * 0.98))) / 400.0) * EV_N)    // Exhaust valve(s) flow cross-sectional area. Calculated automatically, override only if you are a professional. Units: square centimeters. //
label EV_Qmax(EV_A * 0.155 * 146.0)    // Exhaust valve(s) flow area theoretical maximum volumetric flow rate. Calculated automatically. Units: cubic feet per minute at 28 inches of water pressure drop. Do not tamper. //


label CSIL_C(((IV_C + (180.0 * units.deg) - IV_O) / 2.0) + (360.0 * units.deg))    // Camshaft intake lobe centerline. Calculated automatically. Incorrect formula used on purpose due to limitations of legacy implementation. Units: Degrees. Do not tamper. //
label CSIL_G(1.0)    // Camshaft intake lobe gamma(non-linearity). Higher values reduce intake valve lift at the intake event beginning and ending. Disabled if Oror's Lobe Generator is used. // 
label CSIL_dID(100)    // Camshaft intake lobe resolution. Higher values yield smoother intake lobe generation at the expense of loading times. Disabled if Oror's Lobe Generator is used. //

label CSEL_C((EV_C + (540.0 * units.deg) - EV_O) / 2.0)   // Camshaft exhaust lobe centerline. Calculated automatically. Incorrect formula used on purpose due to limitations of legacy implementation. Units: Degrees. Do not tamper. //
label CSEL_G(1.0)    // Camshaft exhaust lobe gamma(non-linearity). Higher values reduce exhaust valve lift at the exhaust event beginning and ending. Disabled if Oror's Lobe Generator is used. // 
label CSEL_dED(100)    // Camshaft exhaust lobe resolution. Higher values yield smoother exhaust lobe generation at the expense of loading times. Disabled if Oror's Lobe Generator is used. //


/*
{
   "cam_cfg":{
      "es_version":"0.1.14a",
      "resolution":100,
      "intake_volume":1.0,
      "exhaust_volume":1.0,
      "intake_at_lift":0.0,
      "exhaust_at_lift":0.0,
      "intake_trim":1.0,
      "exhaust_trim":1.0,
      "intake_sigma":1.0,
      "exhaust_sigma":1.0,
      "intake_base_mult":1.5,
      "exhaust_base_mult":1.5,
      "intake_cos":false,
      "exhaust_cos":false,
      "equal_base_radius":true,
      "ramp_steepness":0,
      "lift_significant_fraction":100,
      "roller_tappet_radius": 0.1
   }
}
*/


label CS_N(1.0)    // Camshaft amount. Does not create camshafts automatically. //  
label CS_rho(7.15)    // Camshaft material density. Units: grams per cubic centimeter. //
label CS_Mm((0.5 * CS_rho) / (CS_rho / 7.15))    // Camshaft mass multiplier. Prevents the camshaft mass from being too low if lighter materials are used. Calculated automatically, override only if you are a professional. //


label CSB_N((EC_N / ECB_N) + 1.0)    // Camshaft bearing amount. Calculated automatically, but can be overridden. //


label CSS_L(CRJ_L + CMB_L)    // Camshaft base length. Calculated automatically, override only if you are a professional. Units: millimeters. //
label CSS_D(((IV_L + EV_L) / 2.0) * 3.0)    // Camshaft base diameter. Calculated automatically, override only if you are a professional. Units: millimeters. //
label CSS_V(((constants.pi * (CSS_D * CSS_D)) * CSS_L) / 4000.0)    // Camshaft base volume. Calculated automatically. Units: cubic centimeters. Do not tamper. //
label CSS_M(CSS_V * CS_rho * CS_Mm)    // Camshaft base mass. Calculated automatically, override only if you are a professional. Units: grams. //
label CSS_MOI((1.0 / 2.0) * (CS_M / 1000.0) * ((CSS_D / 2000.0) * (CSS_D / 2000.0)))    // Camshaft base moment of inertia. Calculated automatically, override only if you are a professional. Units: kilograms times meters squared. //


label CSIL_N((IV_N * EC_N) / CS_N)    // Camshaft intake lobe amount. Calculated automatically. Do not tamper. //
label CSIL_H(IV_L)    // Camshaft intake lobe height. Calculated automatically, override only if you are a professional. Units: millimeters. //
label CSIL_T(IV_D / 2.0)    // Camshaft intake lobe base thickness. Calculated automatically, override only if you are a professional. Units: millimeters. //
label CSIL_V(((CSS_D * CSIL_H * CSIL_T) / 2000.0) * CSIL_N)    // Camshaft intake lobe(s) total volume. Calculated automatically. Units: cubic centimeters. Do not tamper. //
label CSIL_M(CSIL_V * CS_rho * CS_Mm)    // Camshaft intake lobe(s) mass, Calculated automatically, override only if you are a professional. Units: grams. //
label CSIL_MOI((1.0 / 12.0) * (CSIL_M / 1000.0) * ((4.0 * ((CSIL_H / 1000.0) * (CSIL_H / 1000.0))) + ((CSIL_T / 1000.0) * (CSIL_T / 1000.0))))    // Camshaft intake lobe(s) moment of inertia. Calculated automatically, override only if you are a professional. Units: kilograms times meters squared. //


label CSEL_N((EV_N * EC_N) / CS_N)    // Camshaft exhaust lobe amount. Calculated automatically. Do not tamper. //
label CSEL_H(EV_L)    // Camshaft exhaust lobe height. Calculated automatically, override only if you are a professional. Units: millimeters. //
label CSEL_T(EV_D / 2.0)    // Camshaft exhaust lobe base thickness. Calculated automatically, override only if you are a professional. Units: millimeters. //
label CSEL_V(((CSS_D * CSEL_H * CSEL_T) / 2000.0) * CSEL_N)    // Camshaft exhaust lobe(s) volume. Calculated automatically. Units: cubic centimeters. Do not tamper. //
label CSEL_M(CSEL_V * CS_rho * CS_Mm)    // Camshaft exhaust lobe(s) mass. Calculated automatically, override only if you are a professional. Units: grams. //    
label CSEL_MOI((1.0 / 12.0) * (CSEL_M / 1000.0) * ((4.0 * ((CSEL_H / 1000.0) * (CSEL_H / 1000.0))) + ((CSEL_T / 1000.0) * (CSEL_T / 1000.0))))    // Camshaft exhaust lobe(s) moment of inertia. Calculated automatically, override only if you are a professional. Units: kilograms times meters squared. //


label CS_M(CSS_M + ((CSIL_M + CSEL_M) / 2.0))    // Average camshaft mass. Calculated automatically, but can be overriden. Units: grams. //
label CS_Fmu((((CS_M / 1000.0) * 9.80665) * (0.0015 * CSB_N)) * CS_N)    // Total camshaft(s) friction. Calculated automatically, override only if you are a professional. Units: newton meters. //
label CS_MOI((CSS_MOI + CSIL_MOI + CSEL_MOI) * CS_N)    // Total camshaft(s) moment of inertia. Calculated automatically, override only if you are a professional. Units: kilograms times meters squared. //


label CSG_D(CP_D * 2.0)    // Camshaft gear diameter. Calculated automatically. Units: millimeters. Do not tamper. //
label CSG_T(CP_T)    // Camshaft gear thickness. Calculated automatically, but can be overridden. Units: millimeters. //
label CSG_V(((constants.pi * (CSG_D * CSG_D)) * CSG_T) / 4000.0)    // Camshaft gear volume. Calculated automatically. Units: cubic centimeters. Do not tamper. //
label CSG_rho(7.15)    // Camshaft gear material density. Units: grams per cubic centimeter. //
label CSG_Mm((0.5 * CSG_rho) / (CSG_rho / 7.15))    // Camshaft gear mass multiplier. Prevents the camshaft gear mass from being too low if lighter materials are used. Calculated automatically, override only if you are a professional. //
label CSG_M(CSG_V * CSG_rho * CSG_Mm)    // Camshaft gear mass. Calculated automatically, but can be overridden. Units: grams. //
label CSG_MOI(((1.0 / 2.0) * (CSG_M / 1000.0) * ((CSG_D / 2000.0) * (CSG_D / 2000.0))) * CS_N)    // Camshaft gear(s) total moment of inertia. Calculated automatically, override only if you are a professional. Units: kilograms times meters squared. //
label CSG_Fmu((((CSG_M / 1000.0) * 9.80665) * 0.0015) * CS_N)    // Camshaft gear(s) friction. Calculated automatically, override only if you are a professional. Units: newton meters. //

// Valvetrain Parameters End //



// Cylinder Head Parameters Start //

label E_CR(4.0)    // Compression ratio. Determines the "Cylinder displacement + Combustion chamber volume /Combustion chamber volume" ratio. Low, and it has to be. These engines ran on whatever was in the can - gasoline, naphtha, kerosene, distillate - with no octane rating and no way to retard the ignition if it knocked, and they were fired by a make-and-break igniter with a fixed trip. 3.5:1 to 4.5:1 is the period range and 4.0 sits in the middle of it. It leaves a 332 cc combustion chamber, a third of the swept volume, which looks absurd next to a modern engine and is exactly right for this one. //
label CHCC_V(EC_Vcc / (E_CR - 1.0))    // Combustion chamber volume. Calculated automatically, override only if you are a professional. Units: cubic centimeters. //


label CHIPT_Dm(0.70)    // Cylinder head intake port throat diameter multiplier. Determines the "intake port throat diameter/intake valve flow diameter" ratio. //
label CHIPT_A(((constants.pi * ((IV_D * 0.98 * CHIPT_Dm) * (IV_D * 0.98 * CHIPT_Dm))) / 400.0) * IV_N)    // Cylinder head intake port throat cross sectional area. Calculated automatically, override only if you are a professional. Units: square centimeters. //   
label CHIPTIV_R(CHIPT_A / IV_A)    // "Cylinder head intake port throat cross sectional area/intake valve cross sectional flow area" ratio. Calculated automatically. Do not tamper. //
label CHIPT_Qmax(CHIPT_A * 0.155 * 146.0)    // Cylinder head intake port throat theoretical maximum flow rate. Calculated automatically. Units: cubic feet per minute at 28 inches of water pressure drop. Do not tamper. //  

label CHIP_Dm(0.85)    // Cylinder head intake port diameter multiplier. Determines the "intake port upstream diameter/intake valve flow diameter" ratio. // 
label CHIP_A(((constants.pi * ((IV_D * 0.98 * CHIP_Dm) * (IV_D * 0.98 * CHIP_Dm))) / 400.0) * IV_N)    // Cylinder head intake port upstream cross sectional area. Calculated automatically, override only if you are a professional. Units: square centimeters. //    
label CHIPIV_R(CHIP_A / IV_A)    // "Cylinder head intake port upstream cross sectional area/intake valve flow cross sectional area" ratio. Calculated automatically. Do not tamper. // 
label CHIP_Qmax(CHIP_A * 0.155 * 146.0)    // Cylinder head intake port upstream theoretical maximum flow rate. Calculated automatically. Units: cubic feet per minute at 28 inches of water pressure drop. Do not tamper. //

label CHIPI_Dm(1.00)    // Cylinder head intake port inlet diameter multiplier. Determines the "intake port inlet diameter/intake port upstream diameter" ratio. // 
label CHIPI_A(((constants.pi * ((IV_D * 0.98 * CHIP_Dm * CHIPI_Dm) * (IV_D * 0.98 * CHIP_Dm * CHIPI_Dm))) / 400.0) * IV_N)    // Cylinder head intake port inlet cross sectional area. Calculated automatically, override only if you are a professional. Units: square centimeters. //  
label CHIPIIV_R(CHIPI_A / IV_A)    // "Cylinder head intake port inlet area/intake valve flow cross sectional area" ratio. Calculated automatically. Do not tamper. // 
label CHIPI_Qmax(CHIPI_A * 0.155 * 146.0)    // Cylinder head intake port inlet theoretical maximum flow rate. Calculated automatically. Units: cubic feet per minute at 28 inches of water pressure drop. Do not tamper. //   

label CHIP_Vm(0.25)    // Cylinder head intake port volume multiplier. Determines the "cylinder head intake port volume/single cylinder displacement" ratio. //  
label CHIP_V(EC_Vcc * CHIP_Vm)    // Cylinder head intake port volume. Calculated automatically, override only if you are a professional. Units: cubic centimeters. //
label CHIP_L((CHIP_V / CHIPT_A) * 10.0)    // Cylinder head intake port length. Calculated automatically. Incorrect formula used on purpose due to fluid simulation limitations. Units: millimeters. Do not tamper. //

label CHIPIV_Ravg((CHIPIIV_R + CHIPIV_R + CHIPTIV_R) / 3.0)    // Mean average of cylinder head intake port and intake valve flow cross sectional areas ratios. Do not tamper. //  
label CHIPTIVRavg_R(CHIPTIV_R / CHIPIV_Ravg)    // "Cylinder head intake port throat cross sectional area/intake valve flow cross sectional area/mean average intake port and intake valve flow cross sectional area ratios" ratio. //
label CHIPIVRavg_R(CHIPIV_R / CHIPIV_Ravg)    // "Cylinder head intake port cross sectional area/intake valve flow cross sectional area/mean average intake port and intake valve flow cross sectional area ratios" ratio. //   
label CHIPIIVRavg_R(CHIPIIV_R / CHIPIV_Ravg)    // "Cylinder head intake port inlet cross sectional area/intake valve flow cross sectional area/mean average intake port and intake valve flow cross sectional area ratios" ratio. // 

label CHI_Qdm_DISABLED(1.0)    // Cylinder head intake flow at >20mm valve lift bandaid compatibility fix disabled state. Do not tamper. //
label CHI_Qdm_ENABLED(IV_L / 10.0)    // Cylinder head intake flow at >20mm valve lift bandaid compatibility fix enabled state. Do not tamper. //
label CHI_Qdm(CHI_Qdm_DISABLED)    // Cylinder head intake flow at >20mm valve lift bandaid compatibility fix. Works in a simliar way to "lift scale" in default Engine Simulator engines. Override "CHI_Qdm_DISABLED" with "CHI_Qdm_ENABLED" to enable. //


label CHEPT_Dm(0.70)    // Cylinder head exhaust port throat diameter multiplier. Determines the "exhaust port throat diameter/exhaust valve flow diameter" ratio. //   
label CHEPT_A(((constants.pi * ((EV_D * 0.98 * CHEPT_Dm) * (EV_D * 0.98 * CHEPT_Dm))) / 400.0) * EV_N)    // Cylinder head exhaust port throat cross sectional area. Calculated automatically, override only if you are a professional. Units: square centimeters. FIXED, as on the Kaestro Boyotte: every AMLTSP#7.0 template ships this and the two formulas below reading IV_D, the INTAKE valve diameter, while CHEPT_Dm one line above is documented as a fraction of the EXHAUST valve. On this engine the fix happens to change nothing at all, because the intake and exhaust valves are the same 38 mm - which is a good reason to fix it now rather than later, since it means the correction can be made with zero effect on the measured numbers, and anyone who later resizes one valve will not be quietly poisoned by it. //
label CHEPTEV_R(CHEPT_A / EV_A)    // "Cylinder head exhaust port throat area/exhaust valve flow area" ratio. Calculated automatically. Do not tamper. //    
label CHEPT_Qmax(CHEPT_A * 0.155 * 146.0)    // Cylinder head exhaust port throat theoretical maximum flow rate. Calculated automatically. Units: cubic feet per minute at 28 inches of water pressure drop. Do not tamper. //  

label CHEP_Dm(0.85)    // Cylinder head exhaust port downstream diameter multiplier. Determines the "exhaust port downstream diameter/exhaust valve flow diameter" ratio. // 
label CHEP_A(((constants.pi * ((EV_D * 0.98 * CHEP_Dm) * (EV_D * 0.98 * CHEP_Dm))) / 400.0) * EV_N)    // Cylinder head exhaust port downstream cross sectional area. Calculated automatically, override only if you are a professional. Units: square centimeters. IV_D -> EV_D, same upstream bug as CHEPT_A above. //
label CHEPEV_R(CHEP_A / EV_A)    // "Cylinder head exhaust port downstream area/exhaust valve flow area" ratio. Calculated automatically. Do not tamper. //
label CHEP_Qmax (CHEP_A * 0.155 * 146.0)    // Cylinder head exhaust port downstream theoretical maximum flow rate. Calculated automatically. Units: cubic feet per minute at 28 inches of water pressure drop. Do not tamper. //  

label CHEPO_Dm(1.00)    // Cylinder head exhaust port outlet diameter multiplier. Determines the "exhaust port outlet diameter/exhaust port downstream diameter" ratio. //   
label CHEPO_A(((constants.pi * ((EV_D * 0.98 * CHEP_Dm * CHEPO_Dm) * (EV_D * 0.98 * CHEP_Dm * CHEPO_Dm))) / 400.0) * EV_N)    // Cylinder head exhaust port outlet cross sectional area. Calculated automatically, override only if you are a professional. Units: square centimeters. IV_D -> EV_D, same upstream bug as CHEPT_A above. //
label CHEPOEV_R(CHEPO_A / EV_A)    // "Cylinder head exhaust port outlet area/exhaust valve flow area" ratio. Calculated automatically. Do not tamper. // 
label CHEPO_Qmax(CHEPO_A * 0.155 * 146.0)    // Cylinder head exhaust port outlet theoretical maximum flow rate. Calculated automatically. Units: cubic feet per minute at 28 inches of water pressure drop. Do not tamper. //  

label CHEP_Vm(CHEPT_A / CHIPT_A)    // Cylinder head port volume multiplier. Determines the "Cylinder head intake port volume/Cylinder head exhaust port volume" ratio. Default multiplier ensures equal port length. //  
label CHEP_V(CHIP_V * CHEP_Vm)    // Cylinder head exhaust port volume. Calculated automatically, override only if you are a professional. Units: cubic centimeters. //
label CHEP_L((CHEP_V / CHEPT_A) * 10.0)    // Cylinder head exhaust port length. Calculated automatically. Incorrect formula used on purpose due to fluid simulation limitations. Units: millimeters. Do not tamper. //

label CHEPEV_Ravg((CHEPOEV_R + CHEPEV_R + CHEPTEV_R) / 3.0)    // Mean average of cylinder head exhaust port and exhaust valve flow cross sectional areas ratios. Do not tamper. //   
label CHEPTEVRavg_R(CHEPTEV_R / CHEPEV_Ravg)    // "Cylinder head exhaust port throat cross sectional area/exhaust valve flow cross sectional area/mean average exhaust port and exhaust valve flow cross sectional area ratios" ratio. // 
label CHEPEVRavg_R(CHEPEV_R / CHEPEV_Ravg)    // "Cylinder head exhaust port cross sectional area/exhaust valve flow cross sectional area/mean average exhaust port and exhaust valve flow cross sectional area ratios" ratio. // 
label CHEPOEVRavg_R(CHEPOEV_R / CHEPEV_Ravg)    // "Cylinder head exhaust port outlet cross sectional area/exhaust valve flow cross sectional area/mean average exhaust port and exhaust valve flow cross sectional area ratios" ratio. // 

label CHE_Qdm_DISABLED(1.0)    // Cylinder head exhaust flow at >20mm valve lift bandaid compatibility fix disabled state. Do not tamper. //
label CHE_Qdm_ENABLED(EV_L / 10.0)    // Cylinder head exhaust flow at >20mm valve lift bandaid compatibility fix enabled state. Do not tamper. //
label CHE_Qdm(CHI_Qdm_DISABLED)    // Cylinder head exhaust flow at >20mm valve lift bandaid compatibility fix. Works in a simliar way to "lift scale" in default Engine Simulator engines. Override "CHE_Qdm_DISABLED" with "CHE_Qdm_ENABLED" to enable. //

// Cylinder Head Parameters End //



// Intake Parameters Start //

label IM_N(1.0)    // Intake manifold amount. Does not create intake manifolds automatically. //
label IM_VDm(1.0)   // Intake manifold velocity decay multiplier. Determines the rate of air velocity loss inside the intake manifold. //

label IMR_Romega(3600.0)    // Intake manifold runner optimal RPM. Determines the engine speed at which the intake runners perform the best in theory. //
label IMRRWT_N(12.0)    // Intake manifold runner resonance wave travel amount. Determines the theoretical amount of times the low-pressure wave travels up and down the intake runner at optimal runner RPM. //
label IMR_L(80.0)    // Intake manifold runner length. Calculated automatically, but can be overridden. Units: millimeters. Overridden to a literal because the automatic formula is meaningless here. It sizes a runner for resonance at IMR_Romega, and at 500 rpm it asks for a 2.9 METRE intake tract. There is no such thing on this engine and never was: the mixer bolts to a short elbow on the side of the head. 80 mm is that elbow. Resonance tuning is a high-speed idea and this engine has no high speed to tune for. //
label IMR_A(CHIPI_A)    // Intake manifold runner cross-sectional area. Calculated automatically, but can be overridden. Units: square centimeters. //
label IMR_Qmax(IMR_A * 0.155 * 146.0)    // Intake manifold runner theoretical maximum volumetric flow rate. Units: cubic feet per minute at 28 inches of water pressure drop. Mathematical dependency. Do not tamper. //
label IMR_Q(CHIPT_Qmax * 0.95)    // Intake manifold runner actual volumetric flow rate. Calculated automatically, but can be overridden. Units: cubic feet per minute at 28 inches of water pressure drop. //

label IMP_A((IMR_A * EC_N) / IM_N)    // Intake manifold plenum cross sectional area. Calculated automatically, but can be overridden. Units: square centimeters. //
label IMP_Qmax(IMP_A * 0.155 * 146.0)    // Intake manifold plenum theoretical maximum volumetric flow rate. Units: cubic feet per minute at 28 inches of water pressure drop. Mathematical dependency. Do not tamper. //
label IMP_Q((IMR_Q * EC_N) / IM_N)    // Intake manifold plenum actual volumetric flow rate. Calculated automatically, but can be overridden. Units: cubic feet per minute at 28 inches of water pressure drop. //
label IMP_Vm(1.0)    // Intake manifold plenum volume multiplier. Determines the intake plenum volume in relation to the total displacement of cylinders it is feeding. //
label IMP_V((E_Dcc * IMP_Vm) / IM_N)    // Intake manifold plenum volume. Calculated automatically, but can be overridden. Units: cubic centimeters. //

label IM_AFR(13.0)    // Intake air/fuel ratio at wide-open throttle. Richer than stoichiometric because the fuel system is a mixer - a needle valve over a float bowl with no jets, no emulsion tube and no compensation of any kind. It is set once by hand until the engine sounds right and then left for a season. Rich is where it gets set, because lean is where it misfires and overheats. //
label IM_AFR_Cf(0.0)    // Intake air/fuel ratio overfuel correction factor. Can be used to lean out the mixture if the idle fueling causes it to be richer than desired at wide-open throttle. //
label IM_IT(0.0)    // Intake throttle body idle position. 1.0 is fully closed, 0.0 is fully open. ZERO on purpose, and this is a real modelling decision rather than an extreme tune. engine-sim computes plate position as idle_throttle_plate_position * throttle (intake.h getThrottlePlatePosition), so setting this to 0.0 pins the plate wide open and makes the Q/W/E/R throttle keys do NOTHING. That is correct: a hit-and-miss engine has no throttle. There is no pedal, no lever and no plate to move - the mixture is fixed and the ONLY speed control on the entire engine is the governor deciding whether to let the next spark happen. If you load the engine and want it to work harder, you do not open a throttle, you just load it: the governor lets more of the hits through by itself. //
label IM_IF(0.0)    // Intake idle fueling. Can be used to make the air/fuel mixture richer off-throttle. 0.0 is no extra fueling. Adjustment increments of 0.1 or even 0.01 are recommended. //
label IM_TG(1.75)    // Intake throttle body gamma(non-linearity). 1.0 is fully linear. Higher values require more input to open the throttle body by the same amount. //

// Intake Parameters End //



// Fuel Parameters Start //

label FUEL_NAME("Gasoline")    // Fuel name. //
label FUEL_m(114.228)    // Fuel molar mass. Units: grams per mole. Only override if you are a professional. //
label FUEL_rho(740.0 * (units.g / units.L))    // Fuel density. Only override if you are a professional. //
label FUEL_U(46.7 * (units.kJ / units.g))    // Fuel energy density. Only override if you are a professional. //
label FUEL_mAFR(13.8)    // Fuel molecular air-fuel ratio. While the true stoichiometric molecular air-fuel ratio is 12.5:1, due to how Engine Simulator works, 13.8:1 is used instead to achieve mass air-fuel ratio of 14.7:1 being the stoichiometric mixture. Only override if you are a professional. //

// Fuel Parameters End //



// Charge Turbulence and Dilution Parameters Start //

label CHARGE_TDsw(1.0)    // Charge turbulence and dilution adjustment toggle switch. Enables/disables single value turbulence and dilution adjustment. 0.0 - Off, 1.0 - On. //
label CHARGE_TDf(10.0)    // Charge turbulence and dilution adjustment control value. Range: [0.0, 100.0]. Higher values shift the power peak higher up in the RPM range. The template ships 67.0, the top of the band its own chart labels "<55.0 kW/L". This engine makes on the order of 1.1 kW/L, which is off the bottom of that chart entirely, and its power peak needs to be at 400-500 rpm rather than in the thousands. 10.0 is chosen to push the peak as low as the label can push it. //

// Intake charge turbulence and dilution adjustment control value to power per displacement ratio reference chart. //
// Resulting output is not exact and is a subject to deviation based on overall engine build. //

// 100.0 : >150.0kW/L Power to displacement ratio. //
// 89.0-99.0 : 90.0-150.0kW/L Power to displacement ratio. //
// 67.0-89.0 : 55.0-90.0kW/L power to displacement ratio. //
// 0.0-67.0 : <55.0kW/L power to displacement ratio. //

label CHARGE_Tmax(1100.0 - (989.0 * CHARGE_TDsw) - (CHARGE_TDf * CHARGE_TDsw))    // Intake charge maximum turbulence. Calculated automatically, only override if you are a professional. // 
label CHARGE_cVmax(1100.0 - (989.0 * CHARGE_TDsw) - (CHARGE_TDf * CHARGE_TDsw))    // Intake charge maximum dilution. Calculated automatically, only override if you are a professional. //
label FUEL_etamax(0.95)    // Fuel maximum combustion efficiency. Only override if you are a professional. //
label FUEL_etadeltamax(0.1)    // Fuel burning efficiency randomness. Only override if you are a professional. //
label FUEL_etaminmu(0.6 - ((0.0025 * CHARGE_TDf) * CHARGE_TDsw))    // Fuel low burning efficiency attenuation. Only override if you are a professional. //


label TFS_Rbase(4.0)    // Flame speed base multiplier. Only override if you are a professional.//
label TFS_Rm(E_B / E_S)    // Flame speed additional multiplier. Only override if you are a professional.//
label TFS_Ryshift(0.0)    // Flame speed shift. Only override if you are a professional.//

// Charge Turbulence And Dilution Parameters End //



// Exhaust Parameters Start //

label EH_N(1.0)    // Exhaust headers amount. Does not create exhaust headers automatically. //
label EH_VDm(1.0)    // Exhaust headers velocity decay multiplier. Determines the rate of exhaust gases velocity loss inside the exhaust headers. //
label EH_BMm(0.0)    // Exhaust headers backflow mixing. Determines the tendency of exhaust gases to flow back into the cylinder. 0.0 is absence of backflow. //

label EHPT_Somega(3600.0)    // Exhaust headers primary tube scavenging optimal RPM. Determines the engine speed at which the exhaust headers primary tube scavenge the best in theory. //
label EHPT_L(200.0)    // Exhaust headers primary tube length. Calculated automatically, but can be overridden. Units: millimeters. Overridden for the same reason as IMR_L: the scavenging formula wants 9.4 METRES at 500 rpm. A hit-and-miss engine has a cast elbow off the head and then a pipe, and no one has ever tuned one for scavenging. 200 mm is the elbow. //
label EHPT_A(CHEPO_A)    // Exhaust headers primary tube cross sectional area. Calculated automatically, but can be overridden. Units: square centimeters. //
label EHPT_Qmax(EHPT_A * 0.155 * 146.0)    // Exhaust headers primary tube theoretical maximum volumetric flow rate. Units: cubic feet per minute at 28 inches of water pressure drop. Calculated automatically. Mathematical dependency. Do not tamper. // 
label EHPT_Q(CHEPT_Qmax * 0.95)    // Exhaust headers primary tube actual volumetric flow rate. Calculated automatically, but can be overridden. Units: cubic feet per minute at 28 inches of water pressure drop. //

label EHC_L((EHPT_L + CHEP_L) / 2.0)    // Exhaust headers collector length. Calculated automatically, but can be overridden. Units: millimeters. //
label EHC_A(((EHPT_Q * EC_N) / 0.155 / 146.0) / EH_N)    // Exhaust headers collector cross section area. Calculated automatically, but can be overridden. Units: square centimeters. //
label EHC_Qmax(EHC_A * 0.155 * 146.0)    // Exhaust headers collector theoretical maximum volumetric flow rate. Units: cubic feet per minute at 28 inches of water pressure drop. Calculated automatically. Mathematical dependency. Do not tamper. // 
label EHC_Q((EHPT_Q * EC_N) / EH_N)    // Exhaust headers collector actual volumetric flow rate. Calculated automatically, but can be overridden. Units: cubic feet per minute at 28 inches of water pressure drop. //
label EHC_V((EHC_A * EHC_L) / 10.0)    // Exhaust headers collector volume. Calculated automatically. Do not tamper. //

label EP_A(EHC_A)    // Exhaust pipe cross sectional area. Calculated automatically, but can be overridden. Units: square centimeters //
label EP_L(500.0)    // Exhaust pipe length. Units: millimeters. The template's 4000 mm is a car, routed under a floor to a rear bumper. This is a stationary engine on a skid with a short stub pipe and, if its owner was considerate, a small muffler can on the end of it. Short pipe, sharp bark - which matters, because the sound of the thing is most of the reason anyone builds one. //
label EP_V((EP_A * EP_L) / 10.0)    // Exhaust pipe volume. Calculated automatically. Units: cubic centimeters. Do not tamper. //

// Exhaust Parameters End //



// Vehicle Parameters Start //

label V_M(150.0)    // Vehicle mass. Units: kilograms. There is no vehicle. This engine sits bolted to a skid and drives a workshop LINE SHAFT by flat belt, so everything in this section stands in for the shop - engine-sim requires a vehicle and a gearbox whether the engine has them or not. 150 kg is the reflected inertia of the shafting, its hangers and pulleys, and one driven machine. It was 400 kg, which a 1.4 hp engine simply could not accelerate; that is not a modelling insight, it is just too much shop for too little engine. Estimated, not measured. //

label V_B(600.0)    // Vehicle width. Units: millimeters. Only used to compute a frontal area for aerodynamic drag, which on a line shaft is windage off the belts and pulleys. Small. //
label V_H(400.0)    // Vehicle height. Units: millimeters. See V_B. //

label V_Cd(0.05)    // Vehicle drag coefficient. Nearly nothing - a line shaft does not push through the air, it just stirs it. The real parasitic loss in a shop like this is bearing friction along tens of metres of shafting, and that is carried by V_Frr below, which is where it belongs. //

label V_Frr(V_M * 9.80665 * 0.015)    // Vehicle rolling resistance. Calculated automatically, override only if you are a professional. Units: Newtons. //

label V_Ls(40.0) // Vehicle stopping distance. Units: meters. //
label V_Fb(((V_M * (27.77778 * 27.77778)) / 2.0) / V_Ls)    // Vehicle braking force. Calculated automatically, override only if you are a professional. Units: Newtons. //

label T_B(0.0)    // Tire width. Units: millimeters. Zero, because there is no tire. This label only feeds W_D. //
label TA_R(0.0)    // Tire aspect ratio. Percentage. Zero - see T_B. //
label WR_D(19.685)    // Wheel rim diameter. Units: inches. With T_B and TA_R zeroed, W_D collapses to exactly this, so it is the effective drive diameter: 19.685 inches is 500 mm, the flywheel. That is not a fudge - the flat belt genuinely runs on the face of the flywheel, so the flywheel IS the drive pulley and its radius is the right number to turn crankshaft rotation into belt travel. //
label W_D((((T_B * TA_R) / 2540.0) * 2.0) + WR_D)    // Wheel total diameter. Calculated automatically, override only if you are a professional. Units: inches. //

// Vehicle Parameters End //



// Drivetrain Parameters Start //

label E_Nmax(21.0)    // Peak engine torque. Used in drivetrain stiffness calculations. Calculated automatically, but can be overridden after measuring it on the dynamometer. Units: newton meters. MEASURED, but not with the dynamometer - see ENGINE-NOTES.md, the dyno UI is close to unusable on an engine this slow. Taken instead from the engine's own dynamics, which is more trustworthy here because the tachometer is a gauge that actually works. During a miss the engine coasts 521 -> 401 rpm, and the total rotating inertia is known exactly (1.643 kg.m2), so the energy the flywheel gives up is 0.5*I*(w1^2 - w2^2) = 997 J. In steady state the hits must put that same 997 J back. The rise 416 -> 500 rpm takes about 1.0 s at ~460 rpm, which is 3.8 four-stroke cycles, so each firing stroke does about 262 J of work. Against a 997.5 cc displacement that is 2.6 bar BMEP and 21 Nm - which is 1.4 hp at the governed 500 rpm, exactly the historical rating for a 1 litre engine of this type, and bang in the 2-4 bar band a low-compression 1900s stationary engine belongs in. The formula this replaces returns about 2960 Nm, because it divides by engine speed and this engine barely has any. //


label CL_Nmax(E_Nmax * 1.33)    // Clutch maximum torque. Calculated automatically, but can be overridden. Units: newton meters. //
label CL_phimax(2.5)    // Clutch maximum torsion angle. Units: degrees. //
label CL_phik(CL_Nmax / CL_phimax)    // Clutch torsional stiffness. Calculated automatically, override only if you are a professional. Units. newton meters per degree. //
label CL_zeta(2.0)    // Clutch torsional damping coefficient. //


label DR_phimax(2.5)    // Drivetrain maximum torsion angle. Units: degrees. //
label DR_phik((CL_Nmax * 1.33) / DR_phimax)    // Drivetrain torsional stiffness. Calculated automatically, override only if you are a professional. Units: newton meters per degree. //
label DR_zeta(2.0)    // Drivetrain torsional damping coefficient. //


label FD_R(3.0)    // Final drive ratio. The main flat belt, from the flywheel down to the line shaft: 3:1, so the shaft turns about 165 rpm with the engine at its governed 500. That is a normal main-shaft speed for a small shop, and the reduction is what lets 21 Nm move anything at all. //

label GB_R1(4.000)    // First gear ratio. Does not create gears automatically. There is no gearbox either - these five "gears" are the five steps of a cone pulley on the countershaft, which is how a shop of this period changed the speed of a machine: you stop, you lever the belt across to another step, you start again. The steps are a geometric series with a ratio of 1.5, which is how cone pulleys were actually laid out. The whole set was lowered after the engine proved unable to pull the old one. //
label GB_R2(2.667)    // Second gear ratio. Does not create gears automatically. Cone pulley step 2. //
label GB_R3(1.778)    // Third gear ratio. Does not create gears automatically. Cone pulley step 3. //
label GB_R4(1.185)    // Fourth gear ratio. Does not create gears automatically. Cone pulley step 4. //
label GB_R5(0.790)    // Fifth gear ratio. Does not create gears automatically. Cone pulley step 5, the fast step, for something that wants to spin - a fan, a saw arbor, a small dynamo. Overall reduction here is still 2.37:1. //

// Drivetrain Parameters End //



// Dynamometer Parameters Start //

label DYN_RPMmin(200.0)    // Dynamometer minimum speed. Units: revolutions per minute. MUST be changed: the template ships 1000, which on this engine is ABOVE DYN_RPMmax and would leave the dyno with an empty range and no way to sweep it. 200 rpm is about as slow as the engine will pull under load. //
label DYN_RPMmax(E_omegamax)    // Dynamometer maximum speed. Calculated automatically, but can be overridden. Units: revolutions per minute. //
label DYN_dRPM(25.0)    // Dynamometer hold speed steps. Units: revolutions per minute. 25 rather than 100, so the 200-500 rpm range takes twelve steps rather than three. //

// Dynamometer Parameters End //


// Wires start //

private node wires {
    output wire1: ignition_wire();
}

// Wires end //

// Distributor start //

public node Engine_Distributor {
    input wires;
    input timing_curve;
    input rev_limit: E_omegamax * units.rpm;
    input limiter_duration: LICO_t * units.sec;
    alias output __out:
        ignition_module(timing_curve: timing_curve, rev_limit: rev_limit, limiter_duration: limiter_duration)
            .connect_wire(wires.wire1,(-1.0 * (SIM_MCf * units.deg)) +  0 * units.deg);
}

// Distributor End //

// Camshaft Lobes Start //

public node Engine_Camshaft_Intake_Lobe {
    alias output __out:
        harmonic_cam_lobe(
            duration_at_50_thou: ID,
            gamma: CSIL_G,
            lift: IV_L * units.mm,
            steps: CSIL_dID
        );
}

public node Engine_Camshaft_Exhaust_Lobe {
    alias output __out:
        harmonic_cam_lobe(
            duration_at_50_thou: ED,
            gamma: CSEL_G,
            lift: EV_L * units.mm,
            steps: CSEL_dED
        );
}
 
// Camshaft Lobes End //

// Camshafts Start //

public node Engine_Camshaft_Builder {
    output intake_cam_1: Intake_Camshaft_1;
    output exhaust_cam_1: Exhaust_Camshaft_1;

    camshaft_parameters Camshaft_Parameters(
        advance: 0.0 * units.deg,
        base_radius: (CSS_D / 2.0) * units.mm
    )

    camshaft Intake_Camshaft_1(Camshaft_Parameters, lobe_profile: Engine_Camshaft_Intake_Lobe())
    camshaft Exhaust_Camshaft_1(Camshaft_Parameters, lobe_profile: Engine_Camshaft_Exhaust_Lobe())

    Intake_Camshaft_1
        .add_lobe(CSIL_C + (-1.0 * (SIM_MCf * units.deg)) + (0 * units.deg))
    Exhaust_Camshaft_1
        .add_lobe(CSEL_C + (-1.0 * (SIM_MCf * units.deg)) + (0 * units.deg))
}

// Camshafts End //

// Cylinder Head Start //

private node add_flow_sample {
    input lift;
    input flow;
    input this;
    alias output __out: this;

    this.add_sample(lift * units.mm, k_28inH2O(flow))
}

public node Engine_Cylinder_Head {
    input intake_camshaft;
    input exhaust_camshaft;
    input flip_display: false;
    alias output __out: head;

    label AIVCB(IV_A / 10.0000)    // Mathematical dependence. Do not tamper. //
    label AIVC_0(AIVCB * 0.000)    // Mathematical dependence. Do not tamper. //
    label AIVC_1(AIVCB * 1.000)    // Mathematical dependence. Do not tamper. //
    label AIVC_2(AIVCB * 2.000)    // Mathematical dependence. Do not tamper. //
    label AIVC_3(AIVCB * 3.000)    // Mathematical dependence. Do not tamper. //
    label AIVC_4(AIVCB * 4.000)    // Mathematical dependence. Do not tamper. //
    label AIVC_5(AIVCB * 5.000)    // Mathematical dependence. Do not tamper. //
    label AIVC_6(AIVCB * 6.000)    // Mathematical dependence. Do not tamper. //
    label AIVC_7(AIVCB * 7.000)    // Mathematical dependence. Do not tamper. //
    label AIVC_8(AIVCB * 8.000)    // Mathematical dependence. Do not tamper. //
    label AIVC_9(AIVCB * 9.000)    // Mathematical dependence. Do not tamper. //
    label AIVC_10(AIVCB * 10.0)    // Mathematical dependence. Do not tamper. //
    label AIVC_11(AIVCB * 11.0)    // Mathematical dependence. Do not tamper. //
    label AIVC_12(AIVCB * 12.0)    // Mathematical dependence. Do not tamper. //
    label AIVC_13(AIVCB * 13.0)    // Mathematical dependence. Do not tamper. //
    label AIVC_14(AIVCB * 14.0)    // Mathematical dependence. Do not tamper. //
    label AIVC_15(AIVCB * 15.0)    // Mathematical dependence. Do not tamper. //
    label AIVC_16(AIVCB * 16.0)    // Mathematical dependence. Do not tamper. //
    label AIVC_17(AIVCB * 17.0)    // Mathematical dependence. Do not tamper. //
    label AIVC_18(AIVCB * 18.0)    // Mathematical dependence. Do not tamper. //
    label AIVC_19(AIVCB * 19.0)    // Mathematical dependence. Do not tamper. //
    label AIVC_20(AIVCB * 20.0)    // Mathematical dependence. Do not tamper. //

    label AEVCB(EV_A / 10.0000)    // Mathematical dependence. Do not tamper. //
    label AEVC_0(AEVCB * 0.000)    // Mathematical dependence. Do not tamper. //
    label AEVC_1(AEVCB * 1.000)    // Mathematical dependence. Do not tamper. //
    label AEVC_2(AEVCB * 2.000)    // Mathematical dependence. Do not tamper. //
    label AEVC_3(AEVCB * 3.000)    // Mathematical dependence. Do not tamper. //
    label AEVC_4(AEVCB * 4.000)    // Mathematical dependence. Do not tamper. //
    label AEVC_5(AEVCB * 5.000)    // Mathematical dependence. Do not tamper. //
    label AEVC_6(AEVCB * 6.000)    // Mathematical dependence. Do not tamper. //
    label AEVC_7(AEVCB * 7.000)    // Mathematical dependence. Do not tamper. //
    label AEVC_8(AEVCB * 8.000)    // Mathematical dependence. Do not tamper. //
    label AEVC_9(AEVCB * 9.000)    // Mathematical dependence. Do not tamper. //
    label AEVC_10(AEVCB * 10.0)    // Mathematical dependence. Do not tamper. //
    label AEVC_11(AEVCB * 11.0)    // Mathematical dependence. Do not tamper. //
    label AEVC_12(AEVCB * 12.0)    // Mathematical dependence. Do not tamper. //
    label AEVC_13(AEVCB * 13.0)    // Mathematical dependence. Do not tamper. //
    label AEVC_14(AEVCB * 14.0)    // Mathematical dependence. Do not tamper. //
    label AEVC_15(AEVCB * 15.0)    // Mathematical dependence. Do not tamper. //
    label AEVC_16(AEVCB * 16.0)    // Mathematical dependence. Do not tamper. //
    label AEVC_17(AEVCB * 17.0)    // Mathematical dependence. Do not tamper. //
    label AEVC_18(AEVCB * 18.0)    // Mathematical dependence. Do not tamper. //
    label AEVC_19(AEVCB * 19.0)    // Mathematical dependence. Do not tamper. //
    label AEVC_20(AEVCB * 20.0)    // Mathematical dependence. Do not tamper. //

    function intake_flow((1.0 * CHI_Qdm) * units.mm)
    intake_flow
        .add_flow_sample(0.0, 0.0)
        .add_flow_sample((1.0 * CHI_Qdm), IV_Qmax * ((CHIPIV_Ravg + 0.075000187500 + (AIVC_1 / IV_A)) / ((IV_A / AIVC_1) + (CHIPTIVRavg_R * (AIVC_1 / CHIPT_A)) + (CHIPIVRavg_R * (AIVC_1 / CHIP_A)) + (CHIPIIVRavg_R * (AIVC_1 / CHIPI_A)))))
        .add_flow_sample((2.0 * CHI_Qdm), IV_Qmax * ((CHIPIV_Ravg + 0.163582149700 + (AIVC_2 / IV_A)) / ((IV_A / AIVC_2) + (CHIPTIVRavg_R * (AIVC_2 / CHIPT_A)) + (CHIPIVRavg_R * (AIVC_2 / CHIP_A)) + (CHIPIIVRavg_R * (AIVC_2 / CHIPI_A)))))
        .add_flow_sample((3.0 * CHI_Qdm), IV_Qmax * ((CHIPIV_Ravg + 0.258135208900 + (AIVC_3 / IV_A)) / ((IV_A / AIVC_3) + (CHIPTIVRavg_R * (AIVC_3 / CHIPT_A)) + (CHIPIVRavg_R * (AIVC_3 / CHIP_A)) + (CHIPIIVRavg_R * (AIVC_3 / CHIPI_A)))))
        .add_flow_sample((4.0 * CHI_Qdm), IV_Qmax * ((CHIPIV_Ravg + 0.356787370800 + (AIVC_4 / IV_A)) / ((IV_A / AIVC_4) + (CHIPTIVRavg_R * (AIVC_4 / CHIPT_A)) + (CHIPIVRavg_R * (AIVC_4 / CHIP_A)) + (CHIPIIVRavg_R * (AIVC_4 / CHIPI_A)))))
        .add_flow_sample((5.0 * CHI_Qdm), IV_Qmax * ((CHIPIV_Ravg + 0.458604179100 + (AIVC_5 / IV_A)) / ((IV_A / AIVC_5) + (CHIPTIVRavg_R * (AIVC_5 / CHIPT_A)) + (CHIPIVRavg_R * (AIVC_5 / CHIP_A)) + (CHIPIIVRavg_R * (AIVC_5 / CHIPI_A)))))
        .add_flow_sample((6.0 * CHI_Qdm), IV_Qmax * ((CHIPIV_Ravg + 0.563016090900 + (AIVC_6 / IV_A)) / ((IV_A / AIVC_6) + (CHIPTIVRavg_R * (AIVC_6 / CHIPT_A)) + (CHIPIVRavg_R * (AIVC_6 / CHIP_A)) + (CHIPIIVRavg_R * (AIVC_6 / CHIPI_A)))))
        .add_flow_sample((7.0 * CHI_Qdm), IV_Qmax * ((CHIPIV_Ravg + 0.669636689400 + (AIVC_7 / IV_A)) / ((IV_A / AIVC_7) + (CHIPTIVRavg_R * (AIVC_7 / CHIPT_A)) + (CHIPIVRavg_R * (AIVC_7 / CHIP_A)) + (CHIPIIVRavg_R * (AIVC_7 / CHIPI_A)))))
        .add_flow_sample((8.0 * CHI_Qdm), IV_Qmax * ((CHIPIV_Ravg + 0.778185322800 + (AIVC_8 / IV_A)) / ((IV_A / AIVC_8) + (CHIPTIVRavg_R * (AIVC_8 / CHIPT_A)) + (CHIPIVRavg_R * (AIVC_8 / CHIP_A)) + (CHIPIIVRavg_R * (AIVC_8 / CHIPI_A)))))
        .add_flow_sample((9.0 * CHI_Qdm), IV_Qmax * ((CHIPIV_Ravg + 0.888448259600 + (AIVC_9 / IV_A)) / ((IV_A / AIVC_9) + (CHIPTIVRavg_R * (AIVC_9 / CHIPT_A)) + (CHIPIVRavg_R * (AIVC_9 / CHIP_A)) + (CHIPIIVRavg_R * (AIVC_9 / CHIPI_A)))))
        .add_flow_sample((10.0 * CHI_Qdm), IV_Qmax * ((CHIPIV_Ravg + 1.00025693200 + (AIVC_10 / IV_A)) / ((IV_A / AIVC_10) + (CHIPTIVRavg_R * (AIVC_10 / CHIPT_A)) + (CHIPIVRavg_R * (AIVC_10 / CHIP_A)) + (CHIPIIVRavg_R * (AIVC_10 / CHIPI_A)))))
        .add_flow_sample((11.0 * CHI_Qdm), IV_Qmax * ((CHIPIV_Ravg + 1.11347476300 + (AIVC_11 / IV_A)) / ((IV_A / AIVC_11) + (CHIPTIVRavg_R * (AIVC_11 / CHIPT_A)) + (CHIPIVRavg_R * (AIVC_11 / CHIP_A)) + (CHIPIIVRavg_R * (AIVC_11 / CHIPI_A)))))
        .add_flow_sample((12.0 * CHI_Qdm), IV_Qmax * ((CHIPIV_Ravg + 1.22798869700 + (AIVC_12 / IV_A)) / ((IV_A / AIVC_12) + (CHIPTIVRavg_R * (AIVC_12 / CHIPT_A)) + (CHIPIVRavg_R * (AIVC_12 / CHIP_A)) + (CHIPIIVRavg_R * (AIVC_12 / CHIPI_A)))))
        .add_flow_sample((13.0 * CHI_Qdm), IV_Qmax * ((CHIPIV_Ravg + 1.34370350400 + (AIVC_13 / IV_A)) / ((IV_A / AIVC_13) + (CHIPTIVRavg_R * (AIVC_13 / CHIPT_A)) + (CHIPIVRavg_R * (AIVC_13 / CHIP_A)) + (CHIPIIVRavg_R * (AIVC_13 / CHIPI_A)))))
        .add_flow_sample((14.0 * CHI_Qdm), IV_Qmax * ((CHIPIV_Ravg + 1.46053780500 + (AIVC_14 / IV_A)) / ((IV_A / AIVC_14) + (CHIPTIVRavg_R * (AIVC_14 / CHIPT_A)) + (CHIPIVRavg_R * (AIVC_14 / CHIP_A)) + (CHIPIIVRavg_R * (AIVC_14 / CHIPI_A)))))
        .add_flow_sample((15.0 * CHI_Qdm), IV_Qmax * ((CHIPIV_Ravg + 1.57842119500 + (AIVC_15 / IV_A)) / ((IV_A / AIVC_15) + (CHIPTIVRavg_R * (AIVC_15 / CHIPT_A)) + (CHIPIVRavg_R * (AIVC_15 / CHIP_A)) + (CHIPIIVRavg_R * (AIVC_15 / CHIPI_A)))))
        .add_flow_sample((16.0 * CHI_Qdm), IV_Qmax * ((CHIPIV_Ravg + 1.69729213000 + (AIVC_16 / IV_A)) / ((IV_A / AIVC_16) + (CHIPTIVRavg_R * (AIVC_16 / CHIPT_A)) + (CHIPIVRavg_R * (AIVC_16 / CHIP_A)) + (CHIPIIVRavg_R * (AIVC_16 / CHIPI_A)))))
        .add_flow_sample((17.0 * CHI_Qdm), IV_Qmax * ((CHIPIV_Ravg + 1.81709632300 + (AIVC_17 / IV_A)) / ((IV_A / AIVC_17) + (CHIPTIVRavg_R * (AIVC_17 / CHIPT_A)) + (CHIPIVRavg_R * (AIVC_17 / CHIP_A)) + (CHIPIIVRavg_R * (AIVC_17 / CHIPI_A)))))
        .add_flow_sample((18.0 * CHI_Qdm), IV_Qmax * ((CHIPIV_Ravg + 1.93778550500 + (AIVC_18 / IV_A)) / ((IV_A / AIVC_18) + (CHIPTIVRavg_R * (AIVC_18 / CHIPT_A)) + (CHIPIVRavg_R * (AIVC_18 / CHIP_A)) + (CHIPIIVRavg_R * (AIVC_18 / CHIPI_A)))))
        .add_flow_sample((19.0 * CHI_Qdm), IV_Qmax * ((CHIPIV_Ravg + 2.05931646400 + (AIVC_19 / IV_A)) / ((IV_A / AIVC_19) + (CHIPTIVRavg_R * (AIVC_19 / CHIPT_A)) + (CHIPIVRavg_R * (AIVC_19 / CHIP_A)) + (CHIPIIVRavg_R * (AIVC_19 / CHIPI_A)))))
        .add_flow_sample((20.0 * CHI_Qdm), IV_Qmax * ((CHIPIV_Ravg + 2.18165027000 + (AIVC_20 / IV_A)) / ((IV_A / AIVC_20) + (CHIPTIVRavg_R * (AIVC_20 / CHIPT_A)) + (CHIPIVRavg_R * (AIVC_20 / CHIP_A)) + (CHIPIIVRavg_R * (AIVC_20 / CHIPI_A)))))

    function exhaust_flow((1.0 * CHE_Qdm) * units.mm)
    exhaust_flow
        .add_flow_sample(0.0, 0.0)
        .add_flow_sample((1.0 * CHE_Qdm), EV_Qmax * ((CHEPEV_Ravg + 0.07500018750 + (AEVC_1 / EV_A)) / ((EV_A / AEVC_1) + (CHEPTEVRavg_R * (AEVC_1 / CHEPT_A)) + (CHEPEVRavg_R * (AEVC_1 / CHEP_A)) + (CHEPOEVRavg_R * (AEVC_1 / CHEPO_A)))))
        .add_flow_sample((2.0 * CHE_Qdm), EV_Qmax * ((CHEPEV_Ravg + 0.16358214970 + (AEVC_2 / EV_A)) / ((EV_A / AEVC_2) + (CHEPTEVRavg_R * (AEVC_2 / CHEPT_A)) + (CHEPEVRavg_R * (AEVC_2 / CHEP_A)) + (CHEPOEVRavg_R * (AEVC_2 / CHEPO_A)))))
        .add_flow_sample((3.0 * CHE_Qdm), EV_Qmax * ((CHEPEV_Ravg + 0.25813520890 + (AEVC_3 / EV_A)) / ((EV_A / AEVC_3) + (CHEPTEVRavg_R * (AEVC_3 / CHEPT_A)) + (CHEPEVRavg_R * (AEVC_3 / CHEP_A)) + (CHEPOEVRavg_R * (AEVC_3 / CHEPO_A)))))
        .add_flow_sample((4.0 * CHE_Qdm), EV_Qmax * ((CHEPEV_Ravg + 0.35678737080 + (AEVC_4 / EV_A)) / ((EV_A / AEVC_4) + (CHEPTEVRavg_R * (AEVC_4 / CHEPT_A)) + (CHEPEVRavg_R * (AEVC_4 / CHEP_A)) + (CHEPOEVRavg_R * (AEVC_4 / CHEPO_A)))))
        .add_flow_sample((5.0 * CHE_Qdm), EV_Qmax * ((CHEPEV_Ravg + 0.45860417910 + (AEVC_5 / EV_A)) / ((EV_A / AEVC_5) + (CHEPTEVRavg_R * (AEVC_5 / CHEPT_A)) + (CHEPEVRavg_R * (AEVC_5 / CHEP_A)) + (CHEPOEVRavg_R * (AEVC_5 / CHEPO_A)))))
        .add_flow_sample((6.0 * CHE_Qdm), EV_Qmax * ((CHEPEV_Ravg + 0.56301609090 + (AEVC_6 / EV_A)) / ((EV_A / AEVC_6) + (CHEPTEVRavg_R * (AEVC_6 / CHEPT_A)) + (CHEPEVRavg_R * (AEVC_6 / CHEP_A)) + (CHEPOEVRavg_R * (AEVC_6 / CHEPO_A)))))
        .add_flow_sample((7.0 * CHE_Qdm), EV_Qmax * ((CHEPEV_Ravg + 0.66963668940 + (AEVC_7 / EV_A)) / ((EV_A / AEVC_7) + (CHEPTEVRavg_R * (AEVC_7 / CHEPT_A)) + (CHEPEVRavg_R * (AEVC_7 / CHEP_A)) + (CHEPOEVRavg_R * (AEVC_7 / CHEPO_A)))))
        .add_flow_sample((8.0 * CHE_Qdm), EV_Qmax * ((CHEPEV_Ravg + 0.77818532280 + (AEVC_8 / EV_A)) / ((EV_A / AEVC_8) + (CHEPTEVRavg_R * (AEVC_8 / CHEPT_A)) + (CHEPEVRavg_R * (AEVC_8 / CHEP_A)) + (CHEPOEVRavg_R * (AEVC_8 / CHEPO_A)))))
        .add_flow_sample((9.0 * CHE_Qdm), EV_Qmax * ((CHEPEV_Ravg + 0.88844825960 + (AEVC_9 / EV_A)) / ((EV_A / AEVC_9) + (CHEPTEVRavg_R * (AEVC_9 / CHEPT_A)) + (CHEPEVRavg_R * (AEVC_9 / CHEP_A)) + (CHEPOEVRavg_R * (AEVC_9 / CHEPO_A)))))
        .add_flow_sample((10.0 * CHE_Qdm), EV_Qmax * ((CHEPEV_Ravg + 1.0002569320 + (AEVC_10 / EV_A)) / ((EV_A / AEVC_10) + (CHEPTEVRavg_R * (AEVC_10 / CHEPT_A)) + (CHEPEVRavg_R * (AEVC_10 / CHEP_A)) + (CHEPOEVRavg_R * (AEVC_10 / CHEPO_A)))))
        .add_flow_sample((11.0 * CHE_Qdm), EV_Qmax * ((CHEPEV_Ravg + 1.1134747630 + (AEVC_11 / EV_A)) / ((EV_A / AEVC_11) + (CHEPTEVRavg_R * (AEVC_11 / CHEPT_A)) + (CHEPEVRavg_R * (AEVC_11 / CHEP_A)) + (CHEPOEVRavg_R * (AEVC_11 / CHEPO_A)))))
        .add_flow_sample((12.0 * CHE_Qdm), EV_Qmax * ((CHEPEV_Ravg + 1.2279886970 + (AEVC_12 / EV_A)) / ((EV_A / AEVC_12) + (CHEPTEVRavg_R * (AEVC_12 / CHEPT_A)) + (CHEPEVRavg_R * (AEVC_12 / CHEP_A)) + (CHEPOEVRavg_R * (AEVC_12 / CHEPO_A)))))
        .add_flow_sample((13.0 * CHE_Qdm), EV_Qmax * ((CHEPEV_Ravg + 1.3437035040 + (AEVC_13 / EV_A)) / ((EV_A / AEVC_13) + (CHEPTEVRavg_R * (AEVC_13 / CHEPT_A)) + (CHEPEVRavg_R * (AEVC_13 / CHEP_A)) + (CHEPOEVRavg_R * (AEVC_13 / CHEPO_A)))))
        .add_flow_sample((14.0 * CHE_Qdm), EV_Qmax * ((CHEPEV_Ravg + 1.4605378050 + (AEVC_14 / EV_A)) / ((EV_A / AEVC_14) + (CHEPTEVRavg_R * (AEVC_14 / CHEPT_A)) + (CHEPEVRavg_R * (AEVC_14 / CHEP_A)) + (CHEPOEVRavg_R * (AEVC_14 / CHEPO_A)))))
        .add_flow_sample((15.0 * CHE_Qdm), EV_Qmax * ((CHEPEV_Ravg + 1.5784211950 + (AEVC_15 / EV_A)) / ((EV_A / AEVC_15) + (CHEPTEVRavg_R * (AEVC_15 / CHEPT_A)) + (CHEPEVRavg_R * (AEVC_15 / CHEP_A)) + (CHEPOEVRavg_R * (AEVC_15 / CHEPO_A)))))
        .add_flow_sample((16.0 * CHE_Qdm), EV_Qmax * ((CHEPEV_Ravg + 1.6972921300 + (AEVC_16 / EV_A)) / ((EV_A / AEVC_16) + (CHEPTEVRavg_R * (AEVC_16 / CHEPT_A)) + (CHEPEVRavg_R * (AEVC_16 / CHEP_A)) + (CHEPOEVRavg_R * (AEVC_16 / CHEPO_A)))))
        .add_flow_sample((17.0 * CHE_Qdm), EV_Qmax * ((CHEPEV_Ravg + 1.8170963230 + (AEVC_17 / EV_A)) / ((EV_A / AEVC_17) + (CHEPTEVRavg_R * (AEVC_17 / CHEPT_A)) + (CHEPEVRavg_R * (AEVC_17 / CHEP_A)) + (CHEPOEVRavg_R * (AEVC_17 / CHEPO_A)))))
        .add_flow_sample((18.0 * CHE_Qdm), EV_Qmax * ((CHEPEV_Ravg + 1.9377855050 + (AEVC_18 / EV_A)) / ((EV_A / AEVC_18) + (CHEPTEVRavg_R * (AEVC_18 / CHEPT_A)) + (CHEPEVRavg_R * (AEVC_18 / CHEP_A)) + (CHEPOEVRavg_R * (AEVC_18 / CHEPO_A)))))
        .add_flow_sample((19.0 * CHE_Qdm), EV_Qmax * ((CHEPEV_Ravg + 2.0593164640 + (AEVC_19 / EV_A)) / ((EV_A / AEVC_19) + (CHEPTEVRavg_R * (AEVC_19 / CHEPT_A)) + (CHEPEVRavg_R * (AEVC_19 / CHEP_A)) + (CHEPOEVRavg_R * (AEVC_19 / CHEPO_A)))))
        .add_flow_sample((20.0 * CHE_Qdm), EV_Qmax * ((CHEPEV_Ravg + 2.1816502700 + (AEVC_20 / EV_A)) / ((EV_A / AEVC_20) + (CHEPTEVRavg_R * (AEVC_20 / CHEPT_A)) + (CHEPEVRavg_R * (AEVC_20 / CHEP_A)) + (CHEPOEVRavg_R * (AEVC_20 / CHEPO_A)))))
    
    cylinder_head head(
        chamber_volume: CHCC_V * units.cc,
        intake_runner_cross_section_area: CHIPT_A * units.cm2,
        intake_runner_volume: CHIP_V * units.cc,
        exhaust_runner_cross_section_area: CHEPT_A * units.cm2,
        exhaust_runner_volume: CHEP_V * units.cc,
        
        intake_port_flow: intake_flow,
        exhaust_port_flow: exhaust_flow,
        intake_camshaft: intake_camshaft,
        exhaust_camshaft: exhaust_camshaft,
        flip_display: flip_display
    )
}  

// Cylinder Head End //

// Turbulence to Flame Speed Ratio Node Start //

private node Turbulence_To_Flame_Speed_Ratio {
    alias output __out:
        function(2.5)
            .add_sample((0.0), (TFS_Rbase * TFS_Rm) * (0.0 + TFS_Ryshift))
            .add_sample((2.5), (TFS_Rbase * TFS_Rm) * (2.5 + TFS_Ryshift))
            .add_sample((5.0), (TFS_Rbase * TFS_Rm) * (5.0 + TFS_Ryshift))
            .add_sample((7.5), (TFS_Rbase * TFS_Rm) * (7.5 + TFS_Ryshift))
            .add_sample((10.0), (TFS_Rbase * TFS_Rm) * (10.0 + TFS_Ryshift))
            .add_sample((12.5), (TFS_Rbase * TFS_Rm) * (12.5 + TFS_Ryshift))
            .add_sample((15.0), (TFS_Rbase * TFS_Rm) * (15.0 + TFS_Ryshift))
            .add_sample((17.5), (TFS_Rbase * TFS_Rm) * (17.5 + TFS_Ryshift))
            .add_sample((20.0), (TFS_Rbase * TFS_Rm) * (20.0 + TFS_Ryshift))
            .add_sample((22.5), (TFS_Rbase * TFS_Rm) * (22.5 + TFS_Ryshift))
            .add_sample((25.0), (TFS_Rbase * TFS_Rm) * (25.0 + TFS_Ryshift))
            .add_sample((27.5), (TFS_Rbase * TFS_Rm) * (27.5 + TFS_Ryshift))
            .add_sample((30.0), (TFS_Rbase * TFS_Rm) * (30.0 + TFS_Ryshift))
            .add_sample((32.5), (TFS_Rbase * TFS_Rm) * (32.5 + TFS_Ryshift))
            .add_sample((35.0), (TFS_Rbase * TFS_Rm) * (35.0 + TFS_Ryshift))
            .add_sample((37.5), (TFS_Rbase * TFS_Rm) * (37.5 + TFS_Ryshift))
            .add_sample((40.0), (TFS_Rbase * TFS_Rm) * (40.0 + TFS_Ryshift))
            .add_sample((42.5), (TFS_Rbase * TFS_Rm) * (42.5 + TFS_Ryshift))
            .add_sample((45.0), (TFS_Rbase * TFS_Rm) * (45.0 + TFS_Ryshift))
            .add_sample((47.5), (TFS_Rbase * TFS_Rm) * (47.5 + TFS_Ryshift))
            .add_sample((50.0), (TFS_Rbase * TFS_Rm) * (50.0 + TFS_Ryshift))
            .add_sample((52.5), (TFS_Rbase * TFS_Rm) * (52.5 + TFS_Ryshift))
            .add_sample((55.0), (TFS_Rbase * TFS_Rm) * (55.0 + TFS_Ryshift))
            .add_sample((57.5), (TFS_Rbase * TFS_Rm) * (57.5 + TFS_Ryshift))
            .add_sample((60.0), (TFS_Rbase * TFS_Rm) * (60.0 + TFS_Ryshift))
            .add_sample((62.5), (TFS_Rbase * TFS_Rm) * (62.5 + TFS_Ryshift))
            .add_sample((65.0), (TFS_Rbase * TFS_Rm) * (65.0 + TFS_Ryshift))
            .add_sample((67.5), (TFS_Rbase * TFS_Rm) * (67.5 + TFS_Ryshift))
            .add_sample((70.0), (TFS_Rbase * TFS_Rm) * (70.0 + TFS_Ryshift))
            .add_sample((72.5), (TFS_Rbase * TFS_Rm) * (72.5 + TFS_Ryshift))
            .add_sample((75.0), (TFS_Rbase * TFS_Rm) * (75.0 + TFS_Ryshift))
            .add_sample((77.5), (TFS_Rbase * TFS_Rm) * (77.5 + TFS_Ryshift))
            .add_sample((80.0), (TFS_Rbase * TFS_Rm) * (80.0 + TFS_Ryshift))
            .add_sample((82.5), (TFS_Rbase * TFS_Rm) * (82.5 + TFS_Ryshift))
            .add_sample((85.0), (TFS_Rbase * TFS_Rm) * (85.0 + TFS_Ryshift))
            .add_sample((87.5), (TFS_Rbase * TFS_Rm) * (87.5 + TFS_Ryshift))
            .add_sample((90.0), (TFS_Rbase * TFS_Rm) * (90.0 + TFS_Ryshift))
            .add_sample((92.5), (TFS_Rbase * TFS_Rm) * (92.5 + TFS_Ryshift))
            .add_sample((95.0), (TFS_Rbase * TFS_Rm) * (95.0 + TFS_Ryshift))
            .add_sample((97.5), (TFS_Rbase * TFS_Rm) * (97.5 + TFS_Ryshift))
            .add_sample((100.0), (TFS_Rbase * TFS_Rm) * (100.0 + TFS_Ryshift))
            .add_sample((102.5), (TFS_Rbase * TFS_Rm) * (102.5 + TFS_Ryshift))
            .add_sample((105.0), (TFS_Rbase * TFS_Rm) * (105.0 + TFS_Ryshift))
            .add_sample((107.5), (TFS_Rbase * TFS_Rm) * (107.5 + TFS_Ryshift))
            .add_sample((110.0), (TFS_Rbase * TFS_Rm) * (110.0 + TFS_Ryshift))
            .add_sample((112.5), (TFS_Rbase * TFS_Rm) * (112.5 + TFS_Ryshift))
            .add_sample((115.0), (TFS_Rbase * TFS_Rm) * (115.0 + TFS_Ryshift))
            .add_sample((117.5), (TFS_Rbase * TFS_Rm) * (117.5 + TFS_Ryshift))
            .add_sample((120.0), (TFS_Rbase * TFS_Rm) * (120.0 + TFS_Ryshift));
}

// Turbulence to Flame Speed Ratio Node End //

// Engine assembly start //

public node Engine {
    alias output __out: engine;

// Miscellaneous parameters start //

    engine engine(
        name: "Sabar Type H",
        starter_torque: SM_Ftq * units.Nm,
        starter_speed: SM_omega * units.rpm,
        redline: TACHO_REDLINE * units.rpm,
        fuel: fuel(
            name: FUEL_NAME,
            molecular_mass: FUEL_m * units.g,
            density: FUEL_rho,
            energy_density: FUEL_U,
            molecular_afr: FUEL_mAFR,
            max_burning_efficiency: FUEL_etamax,
            burning_efficiency_randomness: FUEL_etadeltamax,
            low_efficiency_attenuation: FUEL_etaminmu,
            max_turbulence_effect: CHARGE_Tmax,
            max_dilution_effect: CHARGE_cVmax,
            turbulence_to_flame_speed_ratio: Turbulence_To_Flame_Speed_Ratio()
        ),
        throttle_gamma: IM_TG,
        convolution: AUDIO_CONV,
        hf_gain: AUDIO_HFG,
        jitter: AUDIO_HFN,
        noise: AUDIO_LFN,
        simulation_frequency: SIM_f,
        max_sle_solver_steps: SIM_SLESd,
        fluid_simulation_steps: SIM_FSd,
        dyno_min_speed: DYN_RPMmin * units.rpm,
        dyno_max_speed: DYN_RPMmax * units.rpm,
        dyno_hold_step: DYN_dRPM * units.rpm
    )

// Miscellaneous parameters end //

// Wires start //

    wires wires()

// Wires end //

// Crankshaft Start //

    crankshaft Crankshaft_1(
        throw: CT_L * units.mm,
        mass: C_M * units.g,
        flywheel_mass: FW_M * units.g,
        friction_torque: ((C_Fmu + CP_Fmu + CHB_Fmu + FW_Fmu + CS_Fmu + CSG_Fmu) * FRIC_m) * units.Nm,
        moment_of_inertia: C_MOI + FW_MOI + CSS_MOI + CSIL_MOI + CSEL_MOI + CSG_MOI + CR_MOIC + CP_MOI + CHB_MOI,
        position_x: 0.0,
        position_y: 0.0,
        tdc: (-1.0 * (SIM_MCf * units.deg)) + 90.0 * units.deg
    )

    rod_journal Rod_Journal_1(angle: 0 * units.deg)

    Crankshaft_1
        .add_rod_journal(Rod_Journal_1)

// Crankshaft End //

// Pistons Parameters Start //
    
    piston_parameters Piston_Parameters(
        mass: P_M * units.g,
        compression_height: PCH_H * units.mm,
        wrist_pin_position: 0.0,
        displacement: 0.0,
        blowby: k_28inH2O(PR_B)
    )

// Pistons End //

// Connecting Rods Parameters Start //

    connecting_rod_parameters Connecting_Rod_Parameters(
        mass: CR_M * units.g,
        length: CR_L * units.mm,
        moment_of_inertia: CR_MOI,
        center_of_mass: 0.0
    )

// Connnecting Rods Parameters End //

// Cylinder Bank Parameters Start //

    cylinder_bank_parameters Cylinder_Bank_Parameters(
        bore: E_B * units.mm,
        deck_height: (CT_L + CR_L + PCH_H) * units.mm
    )

// Cylinder Bank Parameters End //

// Intake Manifolds Start //
    
    intake Intake_Manifold_1(
        plenum_cross_section_area: IMP_A * units.cm2,
        plenum_volume: IMP_V * units.cc,
        intake_flow_rate: k_28inH2O(IMP_Q),
        runner_length: IMR_L * units.mm,
        runner_flow_rate: k_28inH2O(IMR_Q),
        idle_throttle_plate_position: IM_IT,
        idle_flow_rate: k_carb(IM_IF),
        molecular_afr: (FUEL_mAFR + IM_AFR_Cf) * (IM_AFR / 14.7),
        velocity_decay: IM_VDm
    )

// Intake Manifolds End //

// Exhaust Headers Start //

    exhaust_system_parameters Exhaust_System_Parameters(
        length: (EHC_L + EP_L) * units.mm,
        collector_cross_section_area: EP_A * units.cm2,
        volume: (EHC_V + EP_V) * units.cc,
        outlet_flow_rate: k_28inH2O(EHC_Q),
        primary_tube_length: EHPT_L * units.mm,
        primary_flow_rate: k_28inH2O(EHPT_Q),
        velocity_decay: EH_VDm,
        backflow_atmospheric_mixing: EH_BMm
    )

    exhaust_system Exhaust_Headers_1(Exhaust_System_Parameters, impulse_response: ir_lib.default_0, audio_volume: 1.0)

// Exhaust Headers End //

// Cylinder Banks Start //

    cylinder_bank Cylinder_Bank_1(Cylinder_Bank_Parameters, angle: 0.0 * units.deg)
        Cylinder_Bank_1
            .add_cylinder(
                piston: piston(Piston_Parameters),
                connecting_rod: connecting_rod(Connecting_Rod_Parameters),
                rod_journal: Rod_Journal_1,
                intake: Intake_Manifold_1,
                exhaust_system: Exhaust_Headers_1,
                primary_length: (0.0) * units.mm,
                sound_attenuation: 1.00,
                ignition_wire: wires.wire1
            )
    
    engine.add_cylinder_bank(Cylinder_Bank_1)

    engine.add_crankshaft(Crankshaft_1)

    Engine_Camshaft_Builder camshaft()

    Cylinder_Bank_1.set_cylinder_head(
        Engine_Cylinder_Head(
            intake_camshaft: camshaft.intake_cam_1,
            exhaust_camshaft: camshaft.exhaust_cam_1,
            flip_display: false
        )
    )

// Cylinder Banks End //

// Ignition Start //

    // Flat, and flat for a mechanical reason rather than as a simplification.
    // A make-and-break IGNITER is a pair of contacts inside the combustion
    // chamber, knocked apart by a trip rod off the same camshaft that works
    // the exhaust valve. The trip is a fixed lump of steel in a fixed hole:
    // it breaks the contacts at exactly the same crank angle at 300 rpm as
    // at 500, because there is no mechanism anywhere on the engine capable
    // of moving it. No centrifugal weights, no vacuum can, no map. Some
    // engines gave the operator a hand lever to shift it a few degrees for
    // starting, and that is the entire extent of ignition timing control on
    // a machine like this.
    //
    // (The same argument, from the other end, as the Kaestro Boyotte's unit
    // injector: a spark engine advances with rpm because the flame needs a
    // fixed amount of TIME to cross the bore and so needs more crank DEGREES
    // as the crank turns faster. This engine's answer is that it does not
    // have anything to advance it with.)
    //
    // Sampled every 100 rpm rather than the template's 500 because the whole
    // operating range is only 500 rpm wide, and carried out to 1000 so that
    // the curve is still defined if the governor lets it overshoot.
    function timing_curve(100 * units.rpm)
    timing_curve
        .add_sample(0 * units.rpm, IGN_ADV * units.deg)
        .add_sample(100 * units.rpm, IGN_ADV * units.deg)
        .add_sample(200 * units.rpm, IGN_ADV * units.deg)
        .add_sample(300 * units.rpm, IGN_ADV * units.deg)
        .add_sample(400 * units.rpm, IGN_ADV * units.deg)
        .add_sample(500 * units.rpm, IGN_ADV * units.deg)
        .add_sample(600 * units.rpm, IGN_ADV * units.deg)
        .add_sample(700 * units.rpm, IGN_ADV * units.deg)
        .add_sample(800 * units.rpm, IGN_ADV * units.deg)
        .add_sample(900 * units.rpm, IGN_ADV * units.deg)
        .add_sample(1000 * units.rpm, IGN_ADV * units.deg)

    engine.add_ignition_module(
        Engine_Distributor(
            wires: wires,
            timing_curve: timing_curve
        )
    )
}

// Ignition End //

// Engine assembly end //

// Vehicle Start //

public node Vehicle {
    alias output __out:
        vehicle(
            mass: V_M * units.kg,
            drag_coefficient: V_Cd,
            cross_sectional_area: (V_B * units.mm) * (V_H * units.mm),
            diff_ratio: FD_R,
            tire_radius: (W_D / 2) * units.inch,
            rolling_resistance: V_Frr * units.Nm,
            max_brake_force: V_Fb * units.Nm,
            simulate_flex: true,
            stiffness: DR_phik * units.Nm / units.deg,
            limit_flex: true,
            max_flex: DR_phimax * units.deg,
            damping: DR_zeta
        );
}

// Vehicle End //

// Transmission start //

public node Transmission {
    alias output __out:
        transmission(
            max_clutch_torque: CL_Nmax * units.Nm,
            simulate_flex: true,
            clutch_stiffness: CL_phik * units.Nm / units.deg,
            limit_clutch_flex: true,
            max_clutch_flex: CL_phimax * units.deg,
            clutch_damping: CL_zeta
        )
        .add_gear(GB_R1)
        .add_gear(GB_R2)
        .add_gear(GB_R3)
        .add_gear(GB_R4)
        .add_gear(GB_R5);
}

// Transmission End //

public node main {
    set_engine(Engine())
    set_vehicle(Vehicle())
    set_transmission(Transmission())
}

main()
